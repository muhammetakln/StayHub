@using Core.Concretes.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giriş Yap";
}

@model LoginDto

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">🔐 Giriş Yap</h3>
                </div>
                <div class="card-body">
                    <!-- Validation Summary -->
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <form method="post" action="/account/login">
                        <!-- ✅ ANTIFORGERY TOKEN -->
                        @Html.AntiForgeryToken()

                        <!-- User Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">👥 Giriş Türü Seçin *</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio"
                                       class="btn-check"
                                       name="UserType"
                                       id="guestOption"
                                       value="Guest"
                                       checked
                                       asp-for="UserType">
                                <label class="btn btn-outline-primary w-50" for="guestOption">
                                    🏨 Müşteri
                                </label>

                                <input type="radio"
                                       class="btn-check"
                                       name="UserType"
                                       id="adminOption"
                                       value="Admin"
                                       asp-for="UserType">
                                <label class="btn btn-outline-danger w-50" for="adminOption">
                                    👨‍💼 Admin
                                </label>
                            </div>
                            <span asp-validation-for="UserType" class="text-danger d-block mt-2"></span>
                        </div>

                        <hr class="my-3">

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">📧 Email Adresi *</label>
                            <input type="email"
                                   class="form-control"
                                   asp-for="Email"
                                   placeholder="ornek@example.com"
                                   required>
                            <span asp-validation-for="Email" class="text-danger d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">🔑 Şifre *</label>
                            <input type="password"
                                   class="form-control"
                                   asp-for="Password"
                                   placeholder="Şifrenizi girin"
                                   required>
                            <span asp-validation-for="Password" class="text-danger d-block"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="rememberMe"
                                       asp-for="RememberMe">
                                <label class="form-check-label" for="rememberMe">
                                    Beni Hatırla
                                </label>
                            </div>
                        </div>

                        <!-- Login Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                🔓 Giriş Yap
                            </button>
                        </div>

                        <hr class="my-4">

                        <!-- Register Link (Only for Guests) -->
                        <div class="text-center" id="guestRegisterLink">
                            <p>
                                Hesabınız yok mu?
                                <a href="/account/register" class="text-decoration-none fw-bold">
                                    Kaydol
                                </a>
                            </p>
                        </div>

                        <!-- Test Credentials -->
                        <div class="alert alert-info mt-3" role="alert">
                            <h6 class="alert-heading">📝 Test Hesapları:</h6>
                            <small>
                                <strong>Admin:</strong> admin@stayhub.com / Admin@123<br>
                                <strong>Müşteri:</strong> guest@stayhub.com / Guest@123
                            </small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .form-control:focus,
    .btn-check:focus + .btn {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0a58ca, #084298);
        }

    .btn-group {
        display: flex;
        gap: 0;
    }

    .btn-outline-primary {
        border-width: 2px;
    }

    .btn-outline-danger {
        border-width: 2px;
    }

    h3 {
        font-weight: 600;
    }

    .form-label {
        color: #2c3e50;
    }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const guestOption = document.getElementById('guestOption');
        const adminOption = document.getElementById('adminOption');
        const guestRegisterLink = document.getElementById('guestRegisterLink');

        function updateRegisterLink() {
            if (guestOption.checked) {
                guestRegisterLink.style.display = 'block';
            } else {
                guestRegisterLink.style.display = 'none';
            }
        }

        guestOption.addEventListener('change', updateRegisterLink);
        adminOption.addEventListener('change', updateRegisterLink);
        updateRegisterLink();
    });
</script>
