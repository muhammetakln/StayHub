@using Core.Concretes.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ✅ Ana sayfadan gelen veya formdan dönen UserType bilgisini alıyoruz
    var requestedUserType = Context.Request.Query["userType"].ToString();
    var currentUserType = !string.IsNullOrEmpty(requestedUserType) ? requestedUserType : (Model?.UserType ?? "Guest");

    ViewData["Title"] = (currentUserType == "Admin") ? "Otel Yönetim Girişi" : "Giriş Yap";
}

@model LoginDto

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                @* ✅ Başlık ve Renk Dinamik Yapıldı *@
                <div class="card-header text-white p-4 text-center"
                     style="background: @(currentUserType == "Admin" ? "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)" : "linear-gradient(135deg, #667eea 0%, #764ba2 100%)") !important;">
                    <h3 class="mb-0 fw-bold">
                        @(currentUserType == "Admin" ? "👨‍💼 Otel Yönetimi" : "🔐 Giriş Yap")
                    </h3>
                </div>
                <div class="card-body p-4 p-sm-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <strong>✨ Bilgi:</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form method="post" action="/account/login">
                        @Html.AntiForgeryToken()

                        @* ✅ Kullanıcı Türü Seçimi (Hidden olarak tutuluyor ve Radio butonlar kaldırıldı) *@
                        <input type="hidden" asp-for="UserType" value="@currentUserType" />

                        @* Eğer yanlış sayfadaysa geçiş yapabilmesi için küçük bir link *@
                        <div class="text-end mb-3">
                            <a href="/account/login?userType=@(currentUserType == "Admin" ? "Guest" : "Admin")" class="small text-decoration-none text-muted">
                                <i class="bi bi-arrow-left-right me-1"></i> @(currentUserType == "Admin" ? "Müşteri Girişine Geç" : "Otel Yönetimine Geç")
                            </a>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">👤 Kullanıcı Adı veya Email *</label>
                            <input type="text"
                                   class="form-control bg-light"
                                   asp-for="Email"
                                   placeholder="Kullanıcı adınızı veya e-postanızı girin"
                                   required>
                            <span asp-validation-for="Email" class="text-danger d-block small mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">🔑 Şifre *</label>
                            <input type="password"
                                   class="form-control bg-light"
                                   asp-for="Password"
                                   placeholder="Şifrenizi girin"
                                   required>
                            <span asp-validation-for="Password" class="text-danger d-block small mt-1"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" asp-for="RememberMe">
                                <label class="form-check-label text-muted user-select-none" for="rememberMe">Beni Hatırla</label>
                            </div>
                            <a href="/account/forgot-password" class="text-decoration-none fw-semibold" style="color: #764ba2;">Şifremi Unuttum?</a>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn @(currentUserType == "Admin" ? "btn-danger" : "btn-primary") btn-lg fw-bold rounded-pill shadow-sm">
                                🔓 Giriş Yap
                            </button>
                        </div>

                        @if (currentUserType == "Guest")
                        {
                            <hr class="my-4 text-muted">
                            <div class="text-center" id="guestRegisterLink">
                                <p class="mb-0 text-muted">
                                    Hesabınız yok mu?
                                    <a href="/account/register" class="text-decoration-none fw-bold ms-1" style="color: #0a58ca;">Hemen Kaydol</a>
                                </p>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
            background-color: #fff !important;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-danger {
        background: linear-gradient(135deg, #f5576c 0%, #d90429 100%);
        border: none;
        transition: all 0.3s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2) !important;
    }
</style>