@using Core.Concretes.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giriş Yap";
}

@model LoginDto

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                    <h3 class="mb-0 fw-bold text-center">🔐 Giriş Yap</h3>
                </div>
                <div class="card-body p-4 p-sm-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <strong>✨ Bilgi:</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Validation Summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form method="post" action="/account/login">
                        @Html.AntiForgeryToken()

                        <!-- User Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #2c3e50;">👥 Giriş Türü Seçin *</label>
                            <div class="btn-group w-100 shadow-sm" role="group">
                                <input type="radio" class="btn-check" name="UserType" id="guestOption" value="Guest" checked asp-for="UserType">
                                <label class="btn btn-outline-primary w-50 fw-semibold py-2" for="guestOption">🏨 Müşteri</label>

                                <input type="radio" class="btn-check" name="UserType" id="adminOption" value="Admin" asp-for="UserType">
                                <label class="btn btn-outline-danger w-50 fw-semibold py-2" for="adminOption">👨‍💼 Admin</label>
                            </div>
                        </div>

                        <!-- ✅ Email or Username (Label ve Placeholder güncellendi) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">👤 Kullanıcı Adı veya Email *</label>
                            <input type="text"
                                   class="form-control bg-light"
                                   asp-for="Email"
                                   placeholder="Kullanıcı adınızı veya e-postanızı girin"
                                   required>
                            <span asp-validation-for="Email" class="text-danger d-block small mt-1"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">🔑 Şifre *</label>
                            <input type="password"
                                   class="form-control bg-light"
                                   asp-for="Password"
                                   placeholder="Şifrenizi girin"
                                   required>
                            <span asp-validation-for="Password" class="text-danger d-block small mt-1"></span>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" asp-for="RememberMe">
                                <label class="form-check-label text-muted user-select-none" for="rememberMe">Beni Hatırla</label>
                            </div>
                            <a href="/account/forgot-password" class="text-decoration-none fw-semibold" style="color: #764ba2;">Şifremi Unuttum?</a>
                        </div>

                        <!-- Login Button -->
                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm">
                                🔓 Giriş Yap
                            </button>
                        </div>

                        <hr class="my-4 text-muted">

                        <!-- Register Link -->
                        <div class="text-center" id="guestRegisterLink">
                            <p class="mb-0 text-muted">
                                Hesabınız yok mu?
                                <a href="/account/register" class="text-decoration-none fw-bold ms-1" style="color: #0a58ca;">Hemen Kaydol</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
            background-color: #fff !important;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0a58ca 0%, #084298 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3) !important;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const guestOption = document.getElementById('guestOption');
        const adminOption = document.getElementById('adminOption');
        const guestRegisterLink = document.getElementById('guestRegisterLink');

        function updateRegisterLink() {
            if (guestOption.checked) {
                guestRegisterLink.style.opacity = '1';
                guestRegisterLink.style.height = 'auto';
                guestRegisterLink.style.display = 'block';
            } else {
                guestRegisterLink.style.opacity = '0';
                guestRegisterLink.style.height = '0';
                guestRegisterLink.style.display = 'none';
            }
        }

        guestOption.addEventListener('change', updateRegisterLink);
        adminOption.addEventListener('change', updateRegisterLink);
        updateRegisterLink();
    });
</script>