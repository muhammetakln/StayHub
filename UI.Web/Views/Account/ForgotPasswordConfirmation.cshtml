@{
    ViewData["Title"] = "Mail Gönderildi";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-success text-white p-4 text-center" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;">
                    <h3 class="fw-bold mb-0">✅ Mail Gönderildi</h3>
                </div>
                <div class="card-body p-4 p-sm-5 text-center">
                    <p class="text-muted mb-4 fs-5">
                        Eğer sistemimizde kayıtlı bir e-posta adresiniz varsa, şifre sıfırlama bağlantısı gönderilmiştir.
                    </p>

                    <div class="alert alert-warning mb-4" role="alert">
                        Lütfen e-posta kutunuzu (ve gerekiyorsa <b>Spam/Gereksiz</b> klasörünü) kontrol edin.
                    </div>

                    <a href="/account/login" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); border: none;">
                        Giriş Sayfasına Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>