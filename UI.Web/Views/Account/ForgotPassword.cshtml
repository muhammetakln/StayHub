@model UI.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                    <h3 class="fw-bold mb-0">🔑 Şifremi Unuttum</h3>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <p class="text-muted text-center mb-4">Sistemde kayıtlı e-posta adresinizi girin, size şifre sıfırlama bağlantısı gönderelim.</p>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold" style="color: #2c3e50;"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">📧</span>
                                <input asp-for="Email" class="form-control border-start-0 bg-light" placeholder="ornek@mail.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); border: none;">
                            📩 Bağlantı Gönder
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a href="/account/login" class="text-decoration-none fw-semibold" style="color: #764ba2;">← Giriş Sayfasına Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}