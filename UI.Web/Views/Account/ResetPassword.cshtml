@model UI.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırlama";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-success text-white p-4 text-center" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;">
                    <h3 class="fw-bold mb-0">🔄 Yeni Şifre Belirle</h3>
                </div>
                <div class="card-body p-4 p-sm-5">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm mb-4">
                            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold" style="color: #2c3e50;"></label>
                            <input asp-for="NewPassword" class="form-control bg-light" placeholder="Yeni şifreniz" required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold" style="color: #2c3e50;"></label>
                            <input asp-for="ConfirmPassword" class="form-control bg-light" placeholder="Şifreyi tekrar girin" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); border: none;">
                            ✅ Şifremi Güncelle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}