@using UI.Web.Models
@model ProfileViewModel

@{
    // 🔥 SİHİRLİ KISIM BURASI: Giriş yapanın rolüne göre doğru şablonu (Layout) seçer
    if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    ViewData["Title"] = "Profil Ayarları";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2"></i> Profil Bilgilerim</h3>
                    <p class="mb-0 text-white-50 small">Kişisel bilgilerinizi ve hesap güvenliğinizi buradan yönetebilirsiniz.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <strong>✨ Başarılı:</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>

                    <form asp-action="Profile" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">Kişisel Bilgiler</h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold text-muted">Adınız</label>
                                <input asp-for="FirstName" class="form-control bg-light" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold text-muted">Soyadınız</label>
                                <input asp-for="LastName" class="form-control bg-light" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label fw-semibold text-muted">Kullanıcı Adı</label>
                            <input asp-for="UserName" class="form-control bg-light" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Email" class="form-label fw-semibold text-muted">E-Posta Adresi</label>
                            <input asp-for="Email" type="email" class="form-control bg-light" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-shield-lock me-2 text-warning"></i>Şifre Güncelleme (Opsiyonel)</h5>
                        <p class="text-muted small mb-4">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakın.</p>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold text-muted">Mevcut Şifreniz</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control bg-light" placeholder="Şu anki şifrenizi girin" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-muted">Yeni Şifreniz</label>
                            <input asp-for="NewPassword" type="password" class="form-control bg-light" placeholder="Yeni şifre belirleyin" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                            @* YÖNLENDİRME BUTONU DA AKILLI HALE GETİRİLDİ *@
                            <a href="@(User.IsInRole("Admin") ? "/admin/hotel" : "/hotel")" class="btn btn-light border btn-lg px-4 text-dark shadow-sm">
                                <i class="bi bi-arrow-left me-2"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4 shadow">
                                <i class="bi bi-save me-2"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #764ba2;
        box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}