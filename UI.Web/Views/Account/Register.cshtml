@using Core.Concretes.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Kayıt Ol";

    // ✅ GÜVENLİK GÜNCELLEMESİ: 18 yaş sınırını Frontend tarafında hesaplıyoruz
    string maxDate = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd");
}

@model RegisterDto

<div class="register-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="auth-card">
                    <div class="auth-header text-center">
                        <div class="auth-logo-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                        <h2>Hemen Kayıt Olun</h2>
                        <p>StayHub otellerinin ayrıcalıklı dünyasına katılın, konforu keşfedin.</p>
                    </div>

                    <div class="auth-body">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-custom-danger d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                                <div>Lütfen formu kontrol edin ve eksikleri düzeltin.</div>
                            </div>
                        }

                        <form method="post" action="/account/register" class="needs-validation">
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label class="form-label">Adınız *</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-person input-icon"></i>
                                        <input type="text" class="form-control" asp-for="FirstName" placeholder="Örn: Ahmet" required>
                                    </div>
                                    <span asp-validation-for="FirstName" class="text-danger-custom"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Soyadınız *</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-people input-icon"></i>
                                        <input type="text" class="form-control" asp-for="LastName" placeholder="Örn: Yılmaz" required>
                                    </div>
                                    <span asp-validation-for="LastName" class="text-danger-custom"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">T.C. Kimlik Numarası *</label>
                                <div class="input-group-custom">
                                    <i class="bi bi-card-text input-icon"></i>
                                    <input type="text" class="form-control" asp-for="IdentificationNumber" placeholder="11 haneli kimlik numarası" maxlength="11" required>
                                </div>
                                <span asp-validation-for="IdentificationNumber" class="text-danger-custom"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Doğum Tarihi *</label>
                                <div class="input-group-custom">
                                    <i class="bi bi-calendar3 input-icon"></i>
                                    <input type="date" class="form-control input-date-custom" asp-for="DateOfBirth" max="@maxDate" required>
                                </div>
                                <div class="form-text-info mt-1">
                                    <i class="bi bi-info-circle-fill me-1"></i> Rezervasyon güvenliği için en az 18 yaşında olmalısınız.
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger-custom"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">E-posta Adresi *</label>
                                <div class="input-group-custom">
                                    <i class="bi bi-envelope input-icon"></i>
                                    <input type="email" class="form-control" asp-for="Email" placeholder="ahmet@example.com" required>
                                </div>
                                <span asp-validation-for="Email" class="text-danger-custom"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Telefon Numarası</label>
                                <div class="input-group-custom">
                                    <i class="bi bi-phone input-icon"></i>
                                    <input type="tel" class="form-control" asp-for="PhoneNumber" placeholder="0555 123 45 67">
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger-custom"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Ülke</label>
                                <div class="input-group-custom">
                                    <i class="bi bi-globe input-icon"></i>
                                    <input type="text" class="form-control" asp-for="Country" placeholder="Türkiye" value="Turkey">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Açık Adres</label>
                                <div class="input-group-custom align-items-start">
                                    <i class="bi bi-geo-alt input-icon mt-2.5"></i>
                                    <input type="text" class="form-control" asp-for="Address" placeholder="Şehir, İlçe, Mahalle detayları...">
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <label class="form-label">Şifre *</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock input-icon"></i>
                                        <input type="password" class="form-control" asp-for="Password" placeholder="••••••••" required>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger-custom"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Şifre Tekrar *</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock-fill input-icon"></i>
                                        <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="••••••••" required>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger-custom"></span>
                                </div>
                                <div class="col-12 mt-1">
                                    <div class="form-text-muted">
                                        <i class="bi bi-shield-lock me-1"></i> Şifreniz en az 8 karakter olmalı; büyük harf, sayı ve özel karakter içermelidir.
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-auth-submit">
                                    <span>Kayıt İşlemini Tamamla</span> <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                                </button>
                            </div>

                            <div class="auth-footer text-center mt-4 pt-3 border-top">
                                <p class="mb-0 text-muted">
                                    Zaten üye misiniz?
                                    <a href="/account/login" class="link-auth-redirect">Giriş Yap</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Işıltılı Otel/Tatil Teması - Soft Mavi-Beyaz Degrade */
    .register-wrapper {
        background: linear-gradient(135deg, #f4f7f6 0%, #e9f0f8 50%, #dbe7f5 100%);
        min-height: calc(100vh - 60px);
        display: flex;
        align-items: center;
    }

    /* Pürüzsüz Beyaz Cam Kart Mimari Yapısı (Yumuşak Gölgeli) */
    .auth-card {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(25, 118, 210, 0.12); /* Hafif Mavi Çerçeve */
        border-radius: 24px;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        box-shadow: 0 15px 35px rgba(25, 118, 210, 0.08), 0 5px 15px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    /* Üst Başlık Bölümü */
    .auth-header {
        padding: 40px 40px 10px 40px;
    }

    .auth-logo-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #1976d2, #0d47a1); /* Derin Otel Mavisi */
        color: #ffffff;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 20px;
        box-shadow: 0 8px 20px rgba(25, 118, 210, 0.25);
    }

    .auth-header h2 {
        color: #0d47a1; /* Kurumsal Lacivert / Mavi */
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }

    .auth-header p {
        color: #546e7a;
        font-size: 0.95rem;
        font-weight: 400;
    }

    .auth-body {
        padding: 20px 40px 40px 40px;
    }

    /* Giriş Kutuları ve Form Etiketleri */
    .form-label {
        color: #37474f;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .input-group-custom {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-group-custom .input-icon {
            position: absolute;
            left: 16px;
            color: #90a4ae;
            font-size: 1.1rem;
            pointer-events: none;
            transition: color 0.3s ease;
        }

        .input-group-custom .form-control {
            width: 100%;
            padding: 12px 16px 12px 46px;
            background: #ffffff;
            border: 1px solid #cfd8dc;
            border-radius: 12px;
            color: #263238;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .input-group-custom .form-control::placeholder {
                color: #b0bec5;
            }

            /* Mavi Fokus Aura Efekti */
            .input-group-custom .form-control:focus {
                background: #ffffff;
                border-color: #1976d2;
                box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.12);
                outline: none;
            }

                .input-group-custom .form-control:focus + .input-icon {
                    color: #1976d2;
                }

    /* Takvim İkonu Rengi */
    .input-date-custom::-webkit-calendar-picker-indicator {
        opacity: 0.5;
        cursor: pointer;
    }

    /* Bilgi ve Yardım Metinleri */
    .form-text-info {
        font-size: 0.8rem;
        color: #0288d1; /* Canlı Mavi Bilgi Rengi */
        font-weight: 500;
    }

    .form-text-muted {
        font-size: 0.78rem;
        color: #78909c;
        line-height: 1.4;
    }

    /* Dinamik Hata Tasarımı */
    .text-danger-custom {
        font-size: 0.82rem;
        color: #d32f2f;
        margin-top: 4px;
        display: block;
        font-weight: 500;
    }

    .alert-custom-danger {
        background: #ffebee;
        border: 1px solid #ffcdd2;
        color: #c62828;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.9rem;
    }

    /* Buton Tasarımı (Otel/Deniz Mavisi Geçişi) */
    .btn-auth-submit {
        background: linear-gradient(135deg, #1976d2, #0d47a1);
        border: none;
        border-radius: 12px;
        color: #ffffff;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 20px rgba(25, 118, 210, 0.2);
        transition: all 0.3s ease;
    }

        .btn-auth-submit:hover {
            background: linear-gradient(135deg, #1e88e5, #1565c0);
            box-shadow: 0 8px 25px rgba(25, 118, 210, 0.35);
            transform: translateY(-1px);
            color: #ffffff;
        }

    /* Footer Yönlendirme Linki */
    .link-auth-redirect {
        color: #1976d2;
        text-decoration: none;
        font-weight: 600;
        margin-left: 4px;
        transition: color 0.2s ease;
    }

        .link-auth-redirect:hover {
            color: #0d47a1;
            text-decoration: underline;
        }

    .border-top {
        border-top: 1px solid #eceff1 !important;
    }
</style>