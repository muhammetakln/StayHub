@using Core.Concretes.DTOs
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Otel Detayları";
}

@model HotelDetailDto

<div class="container-fluid mt-4">
    <!-- Top Navbar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm">
                <a href="/hotel" class="btn btn-outline-secondary btn-sm">← Otel Listesine Dön</a>
                <div class="d-flex gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/reservation/list" class="btn btn-info btn-sm text-white">📋 Rezervasyonlarım</a>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                👤 @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/account/profile">⚙️ Profil Ayarları</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/account/logout">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">🚪 Güvenli Çıkış</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/account/login" class="btn btn-primary btn-sm">🔑 Giriş Yap</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Otel Başlık ve Hero Bölümü -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="position-relative overflow-hidden rounded-4 shadow" style="height: 450px;">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl" alt="@Model.Name" class="w-100 h-100 object-fit-cover">
                    }
                    else
                    {
                        <div class="w-100 h-100 bg-dark d-flex align-items-center justify-content-center text-white fs-1">🏨</div>
                    }
                    <div class="position-absolute bottom-0 start-0 w-100 p-4 bg-dark bg-opacity-50 text-white">
                        <h1 class="display-4 fw-bold">@Model.Name</h1>
                        <p class="fs-5 mb-0">📍 @Model.City, @Model.Country</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sol Panel: Bilgiler ve Yorumlar -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4 rounded-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-bold mb-0 text-primary">📝 Otel Hakkında</h3>
                        <div class="badge bg-warning text-dark fs-6 px-3 py-2">
                            ⭐ @Model.AverageRating.ToString("F1") / 5 Puan
                        </div>
                    </div>
                    <p class="text-secondary lh-lg" style="font-size: 1.1rem;">@Model.Description</p>
                </div>

                <!-- Yorumlar Bölümü -->
                <div class="card border-0 shadow-sm p-4 rounded-4">
                    <h3 class="fw-bold mb-4">💬 Misafir Deneyimleri (@(Model.Reviews?.Count() ?? 0))</h3>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Guest"))
                    {
                        <div class="bg-light p-4 rounded-3 mb-5 border-start border-4 border-primary">
                            <h5 class="fw-bold text-primary mb-3">Siz de Yorum Yapın</h5>
                            <form asp-controller="Hotel" asp-action="AddReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hotelId" value="@Model.Id" />
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <select name="rating" class="form-select border-primary border-opacity-25" required>
                                            <option value="5">⭐⭐⭐⭐⭐ (Harika)</option>
                                            <option value="4">⭐⭐⭐⭐ (Çok İyi)</option>
                                            <option value="3">⭐⭐⭐ (İyi)</option>
                                            <option value="2">⭐⭐ (Kötü)</option>
                                            <option value="1">⭐ (Çok Kötü)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8 mb-3">
                                        <input type="text" name="title" class="form-control border-primary border-opacity-25" placeholder="Yorum Başlığı" required />
                                    </div>
                                </div>
                                <textarea name="comment" class="form-control border-primary border-opacity-25 mb-3" rows="3" placeholder="Konaklamanız nasıldı?" required></textarea>
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Yorumu Yayınla</button>
                            </form>
                        </div>
                    }

                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-4 mb-4">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold fs-5">@review.GuestName</span>
                                    <span class="text-warning">@string.Concat(Enumerable.Repeat("⭐", review.Rating))</span>
                                </div>
                                <h6 class="text-primary mt-1">@review.Title</h6>
                                <p class="text-muted">@review.Content</p>
                                <small class="text-secondary opacity-75">📅 @review.CreatedAt.ToString("dd MMMM yyyy", new CultureInfo("tr-TR"))</small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted italic">Bu otel için henüz yorum yapılmamış.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Sağ Panel: Rezervasyon İşlemleri -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg p-4 rounded-4 position-sticky" style="top: 20px;">
                    <h3 class="fw-bold mb-4 text-center border-bottom pb-3">🛏️ Rezervasyon Yap</h3>

                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Guest"))
                    {
                        <form method="post" action="/reservation/create/@Model.Id">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold">Oda Seçimi</label>
                                <select name="RoomId" id="RoomSelect" class="form-select form-select-lg shadow-sm" required onchange="updatePrice()">
                                    <option value="" data-price="0">-- Müsait Odalar --</option>
                                    @if (Model.Rooms != null)
                                    {
                                        foreach (var room in Model.Rooms)
                                        {
                                            <option value="@room.Id" data-price="@room.Price.ToString(CultureInfo.InvariantCulture)">
                                                @room.Name (@room.Price.ToString("N0") TL / Gece)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold small">📅 Giriş Tarihi</label>
                                    <input type="date" name="CheckInDate" id="CheckInDate" class="form-control" required onchange="updatePrice()">
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold small">📅 Çıkış Tarihi</label>
                                    <input type="date" name="CheckOutDate" id="CheckOutDate" class="form-control" required onchange="updatePrice()">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small">👥 Misafir Sayısı</label>
                                <input type="number" name="NumberOf" id="NumberOf" class="form-control" min="1" max="10" value="1" required onchange="updatePrice()">
                            </div>

                            <!-- ✅ EK HİZMETLER (DINAMIK) -->
                            <div class="mb-4 bg-light p-3 rounded-3 border">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-gift"></i> Ekstra Hizmetler</h6>
                                <div id="addOnServicesContainer">
                                    @if (Model.AddOnServices != null && Model.AddOnServices.Any())
                                    {
                                        foreach (var service in Model.AddOnServices)
                                        {
                                            <div class="form-check d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                                                <div>
                                                    <input class="form-check-input addon-checkbox" type="checkbox"
                                                           value="@service.Id"
                                                           data-price="@service.Price.ToString(CultureInfo.InvariantCulture)"
                                                           id="service_@service.Id"
                                                           onchange="updatePrice()">
                                                    <label class="form-check-label small fw-semibold" for="service_@service.Id">
                                                        @service.Name
                                                    </label>
                                                </div>
                                                <span class="badge bg-secondary">+@service.Price.ToString("N0") TL</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small text-center mb-0">Hizmet bulunmuyor.</p>
                                    }
                                </div>
                            </div>

                            <div class="mb-4 text-center bg-primary bg-opacity-10 p-3 rounded-3">
                                <span class="text-muted small d-block">Ödenecek Toplam Tutar</span>
                                <h2 id="totalPriceDisplay" class="text-primary fw-bold mb-0">0,00 ₺</h2>
                                <input type="hidden" name="TotalPrice" id="hiddenTotalPrice" value="0">
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill py-3 shadow">🚀 Rezervasyonu Tamamla</button>
                                <a href="/hotel" class="btn btn-link btn-sm text-secondary">Ana Sayfaya Dön</a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center rounded-4 shadow-sm border-0">
                            <p class="mb-3">Rezervasyon yapabilmek için giriş yapmalısınız.</p>
                            <a href="/account/login" class="btn btn-primary w-100 fw-bold">Giriş Yap</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .object-fit-cover {
        object-fit: cover;
    }

    .rounded-4 {
        border-radius: 1.5rem !important;
    }

    .shadow-lg {
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }

    .hover-shadow:hover {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        transition: 0.3s;
    }
</style>

<script>
    function updatePrice() {
        const roomSelect = document.getElementById("RoomSelect");
        const checkIn = document.getElementById("CheckInDate").value;
        const checkOut = document.getElementById("CheckOutDate").value;
        const guestInput = document.getElementById("NumberOf");
        const priceDisplay = document.getElementById("totalPriceDisplay");
        const hiddenPrice = document.getElementById("hiddenTotalPrice");

        // ✅ Ek hizmetlerin toplamını hesapla
        const addons = document.querySelectorAll(".addon-checkbox:checked");
        let addonTotal = 0;
        addons.forEach(checkbox => {
            addonTotal += parseFloat(checkbox.getAttribute("data-price") || 0);
        });

        // Oda ve tarih seçilmediyse sıfırla
        if (roomSelect.selectedIndex === 0 || !checkIn || !checkOut) {
            priceDisplay.innerText = "0,00 ₺";
            if(hiddenPrice) hiddenPrice.value = 0;
            return;
        }

        const roomPrice = parseFloat(roomSelect.options[roomSelect.selectedIndex].getAttribute("data-price") || 0);
        const guestCount = parseInt(guestInput.value) || 1;

        // Gece sayısını milisaniye farkı üzerinden hesapla
        const d1 = new Date(checkIn);
        const d2 = new Date(checkOut);
        const nights = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));

        if (nights > 0) {
            // Temel Fiyat: (Gece Sayısı * Oda Fiyatı) + (Ekstra Misafir Başı 150 TL) + Ek Hizmetler
            const baseTotal = nights * roomPrice;
            const extraCharge = guestCount > 1 ? (guestCount - 1) * 150 : 0;
            const finalTotal = baseTotal + extraCharge + addonTotal;

            // TL Formatında gösterim
            priceDisplay.innerText = finalTotal.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
            if(hiddenPrice) hiddenPrice.value = finalTotal;
        } else {
            priceDisplay.innerText = "Hatalı Tarih!";
            if(hiddenPrice) hiddenPrice.value = 0;
        }
    }

    // Sayfa yüklendiğinde tarih kısıtlaması (Bugünden öncesi seçilemesin)
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('CheckInDate').setAttribute('min', today);
        document.getElementById('CheckOutDate').setAttribute('min', today);
    });
</script>