@using Core.Concretes.DTOs
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Otel Detayları";
}

@model HotelDetailDto

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm">
                <a href="/hotel" class="btn btn-outline-secondary btn-sm">← Otel Listesine Dön</a>
                <div class="d-flex gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/reservation/list" class="btn btn-info btn-sm text-white">📋 Rezervasyonlarım</a>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                👤 @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/account/profile">⚙️ Profil Ayarları</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/account/logout">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">🚪 Güvenli Çıkış</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/account/login" class="btn btn-primary btn-sm">🔑 Giriş Yap</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div id="mainGalleryCarousel" class="carousel slide shadow rounded-4 overflow-hidden" data-bs-ride="carousel" style="background-color: #222;">
                    <div class="carousel-inner" id="mainCarouselInner">
                        <div class="carousel-item active" id="hotelPrimaryItem">
                            <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-hotel.jpg" : Model.CoverImageUrl)"
                                 class="gallery-img">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-pill py-2">
                                <h2 class="mb-0">@Model.Name</h2>
                                <p class="mb-0">📍 @Model.City, @Model.Country</p>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#mainGalleryCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                        <span class="visually-hidden">Geri</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#mainGalleryCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                        <span class="visually-hidden">İleri</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4 rounded-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-bold mb-0 text-primary">📝 Otel Hakkında</h3>
                        <div class="badge bg-warning text-dark fs-6 px-3 py-2">
                            ⭐ @Model.AverageRating.ToString("F1") / 5 Puan
                        </div>
                    </div>
                    <p class="text-secondary lh-lg" style="font-size: 1.1rem;">@Model.Description</p>
                </div>

                <div class="card border-0 shadow-sm p-4 rounded-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0">💬 Misafir Deneyimleri (@(Model.Reviews?.Count() ?? 0))</h3>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="btn btn-primary btn-sm rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#reviewFormCollapse">
                                ✍️ Yorum Yap
                            </button>
                        }
                    </div>

                    <div class="collapse mb-5" id="reviewFormCollapse">
                        <div class="bg-light p-4 rounded-4 border border-primary border-opacity-25">
                            <h5 class="fw-bold mb-3">Deneyiminizi Paylaşın</h5>
                            <form id="reviewForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="HotelId" id="revHotelId" value="@Model.Id" />
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label class="form-label small fw-bold">Başlık</label>
                                        <input type="text" name="Title" id="revTitle" class="form-control shadow-sm" placeholder="Örn: Harika bir konaklama" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Puanınız</label>
                                        <select name="Rating" id="revRating" class="form-select shadow-sm" required>
                                            <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                                            <option value="4">⭐⭐⭐⭐ (4/5)</option>
                                            <option value="3">⭐⭐⭐ (3/5)</option>
                                            <option value="2">⭐⭐ (2/5)</option>
                                            <option value="1">⭐ (1/5)</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold">Yorumunuz</label>
                                        <textarea name="Content" id="revContent" class="form-control shadow-sm" rows="3" placeholder="Görüşlerinizi buraya yazın..." required></textarea>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="button" onclick="submitReview()" class="btn btn-primary rounded-pill px-4 shadow">Yorumu Gönder</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div id="reviewsList">
                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="border-bottom pb-4 mb-4">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="fw-bold fs-5 d-block">@review.GuestName</span>
                                            <h6 class="text-primary mt-1">@review.Title</h6>
                                        </div>
                                        <span class="text-warning fs-5">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <span>⭐</span>
                                            }
                                        </span>
                                    </div>
                                    <p class="text-muted mt-2">@review.Content</p>
                                    <small class="text-secondary opacity-75">📅 @review.CreatedAt.ToString("dd MMMM yyyy", new CultureInfo("tr-TR"))</small>

                                    @if (review.IsReplied && !string.IsNullOrEmpty(review.OwnerReply))
                                    {
                                        <div class="bg-light p-3 rounded-3 border-start border-4 border-primary ms-4 mt-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <small class="fw-bold text-primary">
                                                    <i class="bi bi-reply-fill"></i> Otel Yönetiminin Yanıtı
                                                </small>
                                                @if (review.OwnerReplyDate.HasValue)
                                                {
                                                    <small class="text-muted" style="font-size: 0.75rem;">@review.OwnerReplyDate.Value.ToString("dd.MM.yyyy")</small>
                                                }
                                            </div>
                                            <p class="mb-0 text-dark small italic">@review.OwnerReply</p>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5" id="noReviewText">
                                <i class="bi bi-chat-dots fs-1 text-light"></i>
                                <p class="text-muted mt-3 italic">Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-lg p-4 rounded-4 position-sticky" style="top: 20px;">
                    <h3 class="fw-bold mb-4 text-center border-bottom pb-3">🛏️ Rezervasyon Yap</h3>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" action="/reservation/create/@Model.Id" id="reservationForm">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold">Oda Seçimi</label>
                                <select name="RoomId" id="RoomSelect" class="form-select form-select-lg shadow-sm" required onchange="handleRoomChange()">
                                    <option value="" data-price="0">-- Müsait Odalar --</option>
                                    @if (Model.Rooms != null)
                                    {
                                        foreach (var room in Model.Rooms)
                                        {
                                            var roomImagesJson = System.Text.Json.JsonSerializer.Serialize(room.RoomImage?.Select(i => i.ImageUrl) ?? new List<string>());
                                            <option value="@room.Id"
                                                    data-price="@room.Price.ToString(CultureInfo.InvariantCulture)"
                                                    data-images='@Html.Raw(roomImagesJson)'
                                                    data-name="@room.Name">
                                                @room.Name (@room.Price.ToString("N0") TL / Gece)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold small">📅 Giriş</label>
                                    <input type="date" name="CheckInDate" id="CheckInDate" class="form-control" required onchange="updatePrice()">
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold small">📅 Çıkış</label>
                                    <input type="date" name="CheckOutDate" id="CheckOutDate" class="form-control" required onchange="updatePrice()">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small">👥 Misafir Sayısı</label>
                                <input type="number" name="NumberOf" id="NumberOf" class="form-control" min="1" max="10" value="1" required onchange="updatePrice()">
                            </div>

                            <div class="mb-4 bg-light p-3 rounded-3 border">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-gift"></i> Ekstra Hizmetler</h6>
                                @if (Model.AddOnServices != null && Model.AddOnServices.Any())
                                {
                                    foreach (var service in Model.AddOnServices)
                                    {
                                        <div class="form-check d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                                            <div>
                                                <input class="form-check-input addon-checkbox" type="checkbox" name="SelectedServiceIds" value="@service.Id" data-price="@service.Price.ToString(CultureInfo.InvariantCulture)" id="service_@service.Id" onchange="updatePrice()">
                                                <label class="form-check-label small" for="service_@service.Id">@service.Name</label>
                                            </div>
                                            <span class="badge bg-secondary">+@service.Price.ToString("N0") TL</span>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="mb-4 text-center bg-primary bg-opacity-10 p-3 rounded-3">
                                <span class="text-muted small d-block">Toplam Tutar</span>
                                <h2 id="totalPriceDisplay" class="text-primary fw-bold mb-0">0,00 ₺</h2>
                            </div>

                            <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow" disabled>🚀 Rezervasyonu Tamamla</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="bg-light rounded-4 p-4 border border-dashed">
                                <i class="bi bi-lock-fill fs-1 text-warning mb-3 d-block"></i>
                                <h5 class="fw-bold">Oturum Açmanız Gerekiyor</h5>
                                <p class="text-muted small mb-4">Rezervasyon yapabilmek için lütfen giriş yapın.</p>
                                <a href="/account/login" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm">🔑 Giriş Yap / Üye Ol</a>
                                <p class="mt-3 mb-0 small"><a href="/hotel" class="text-decoration-none text-secondary">Vazgeç, listeye dön</a></p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<script>
    let myCarousel;

    document.addEventListener('DOMContentLoaded', function() {
        const carouselEl = document.getElementById('mainGalleryCarousel');
        myCarousel = new bootstrap.Carousel(carouselEl, { interval: 5000, pause: 'hover' });

        const today = new Date().toISOString().split('T')[0];
        if(document.getElementById('CheckInDate')) document.getElementById('CheckInDate').min = today;
        if(document.getElementById('CheckOutDate')) document.getElementById('CheckOutDate').min = today;
    });

    function submitReview() {
        const hotelId = $("#revHotelId").val();
        const rating = $("#revRating").val();
        const title = $("#revTitle").val();
        const content = $("#revContent").val();
        const token = $('input[name="__RequestVerificationToken"]').val();

        if (!title || !content) {
            alert("Lütfen tüm alanları doldurun.");
            return;
        }

        $.ajax({
            url: '/hotel/add-review',
            type: 'POST',
            data: {
                hotelId: hotelId,
                rating: rating,
                title: title,
                Content: content,
                __RequestVerificationToken: token
            },
            success: function (response) {
                if (response.success) {
                    $("#reviewForm")[0].reset();
                    bootstrap.Collapse.getInstance(document.getElementById('reviewFormCollapse')).hide();
                    location.reload();
                } else {
                    alert(response.message);
                }
            }
        });
    }

    // ✅ DÜZELTİLMİŞ ODA SEÇİM VE RESİM DEĞİŞTİRME FONKSİYONU
    function handleRoomChange() {
        const roomSelect = document.getElementById("RoomSelect");
        const carouselInner = document.getElementById("mainCarouselInner");
        const hotelPrimaryItem = document.getElementById("hotelPrimaryItem");
        const selectedOption = roomSelect.options[roomSelect.selectedIndex];

        // 1. Önceki seçilmiş odaya ait resimleri temizle
        const extraItems = carouselInner.querySelectorAll('.carousel-item:not(#hotelPrimaryItem)');
        extraItems.forEach(item => item.remove());

        if (roomSelect.selectedIndex > 0) {
            let images = [];
            try {
                // Tırnak hatalarını önlemek için güvenli parse
                const data = selectedOption.getAttribute("data-images");
                images = JSON.parse(data || "[]");
            } catch (e) {
                console.error("Görsel verisi okunurken hata oluştu:", e);
            }

            const roomName = selectedOption.getAttribute("data-name");

            if (images.length > 0) {
                // Ana otel resmini pasif yapıyoruz
                hotelPrimaryItem.classList.remove('active');

                images.forEach((img, index) => {
                    const div = document.createElement('div');
                    // İlk oda resmini direkt "active" yapıyoruz (Siyah ekran çökmesini engeller)
                    div.className = index === 0 ? 'carousel-item active' : 'carousel-item';

                    // Windows dosya yollarındaki ters bölüleri (\) normal bölüye (/) çeviriyoruz
                    let imgUrl = img.replace(/\\/g, '/');
                    const src = (imgUrl.startsWith('/') || imgUrl.startsWith('http')) ? imgUrl : '/' + imgUrl;

                    div.innerHTML = `
                        <img src="${src}" class="gallery-img" loading="lazy" onerror="this.src='/images/default-hotel.jpg'">
                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-pill py-2">
                            <h2 class="mb-0">${roomName}</h2>
                            <span class="badge bg-info">Oda Görseli</span>
                        </div>
                    `;
                    carouselInner.appendChild(div);
                });
            } else {
                // Eğer odanın resmi yoksa, otelin ana resmine geri dön
                hotelPrimaryItem.classList.add('active');
            }
        } else {
            // Seçim iptal edildiyse (Müsait Odalar seçiliyse) otelin ana resmine geri dön
            hotelPrimaryItem.classList.add('active');
        }

        updatePrice();
    }

    function updatePrice() {
        const roomSelect = document.getElementById("RoomSelect");
        const checkIn = document.getElementById("CheckInDate")?.value;
        const checkOut = document.getElementById("CheckOutDate")?.value;
        const guestInput = document.getElementById("NumberOf")?.value;
        const priceDisplay = document.getElementById("totalPriceDisplay");
        const submitBtn = document.getElementById("submitBtn");

        if(!priceDisplay) return;

        let addonTotal = 0;
        document.querySelectorAll(".addon-checkbox:checked").forEach(cb => {
            addonTotal += parseFloat(cb.getAttribute("data-price") || 0);
        });

        if (roomSelect.selectedIndex === 0 || !checkIn || !checkOut) {
            priceDisplay.innerText = "0,00 ₺";
            if(submitBtn) submitBtn.disabled = true;
            return;
        }

        const roomPrice = parseFloat(roomSelect.options[roomSelect.selectedIndex].getAttribute("data-price") || 0);
        const nights = Math.ceil((new Date(checkOut) - new Date(checkIn)) / (1000 * 60 * 60 * 24));

        if (nights > 0) {
            const extraCharge = (parseInt(guestInput) > 1) ? (parseInt(guestInput) - 1) * 150 : 0;
            const total = (nights * roomPrice) + extraCharge + addonTotal;
            priceDisplay.innerText = total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
            if(submitBtn) submitBtn.disabled = false;
        } else {
            priceDisplay.innerText = "Geçersiz Tarih";
            if(submitBtn) submitBtn.disabled = true;
        }
    }
</script>

<style>
    #mainGalleryCarousel {
        height: 500px !important;
        min-height: 500px;
    }

    .carousel-inner, .carousel-item {
        height: 500px !important;
    }

    .gallery-img {
        width: 100%;
        height: 500px !important;
        object-fit: cover;
        display: block;
    }

    .carousel-control-prev-icon, .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.5);
        border-radius: 50%;
        padding: 20px;
    }

    .italic {
        font-style: italic;
    }
</style>