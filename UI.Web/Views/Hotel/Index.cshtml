@using Core.Concretes.DTOs
@model List<HotelDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Konaklama Seçenekleri";
}

<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-end">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold text-dark">🏨 Otelleri Keşfedin</h1>
            <p class="text-muted fs-5">
                @if (!string.IsNullOrEmpty(ViewBag.City))
                {
                    <span>📍 <strong>@ViewBag.City</strong> şehrindeki oteller listeleniyor (@ViewBag.ResultCount sonuç)</span>
                }
                else
                {
                    <span>Hayalinizdeki konaklama noktasına bir adım uzaklıktasınız.</span>
                }
            </p>
        </div>
        <div class="col-md-5 text-md-end">
            <div class="d-flex gap-2 justify-content-md-end">
                <a href="/reservation/list" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-calendar3 me-2"></i> Rezervasyonlarım
                </a>

                <a href="/hotel" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise"></i> Tümünü Göster
                </a>
            </div>
        </div>
    </div>

    @* --- Arama Çubuğu --- *@
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                <div class="card-body p-4">
                    <form method="get" action="/hotel" class="row g-3 justify-content-center">
                        <div class="col-md-8">
                            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                                <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-geo-alt text-primary"></i></span>
                                <input type="text"
                                       name="city"
                                       class="form-control border-0 py-3"
                                       placeholder="Hangi şehre gitmek istersiniz? (Örn: Antalya, İstanbul...)"
                                       value="@ViewBag.City">
                                <button type="submit" class="btn btn-primary px-5 fw-bold">🔍 Şehir Ara</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* --- Şehir Hızlı Linkleri --- *@
    <div class="row mb-4">
        <div class="col-12 text-center">
            <div class="d-flex gap-2 flex-wrap justify-content-center">
                <a href="/hotel?city=Istanbul" class="btn btn-light border shadow-sm btn-sm px-3 rounded-pill">🌆 İstanbul</a>
                <a href="/hotel?city=Antalya" class="btn btn-light border shadow-sm btn-sm px-3 rounded-pill">☀️ Antalya</a>
                <a href="/hotel?city=Izmir" class="btn btn-light border shadow-sm btn-sm px-3 rounded-pill">🌊 İzmir</a>
                <a href="/hotel?city=Ankara" class="btn btn-light border shadow-sm btn-sm px-3 rounded-pill">🏛️ Ankara</a>
                <a href="/hotel?city=Mugla" class="btn btn-light border shadow-sm btn-sm px-3 rounded-pill">🌴 Muğla</a>
            </div>
        </div>
    </div>

    @* --- Otel Kartları --- *@
    @if (Model != null && Model.Any(h => h.IsActive))
    {
        <div class="row">
            @foreach (var hotel in Model.Where(h => h.IsActive))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm hotel-card rounded-4 overflow-hidden">
                        <div class="position-relative" style="height: 230px;">
                            <img src="@(string.IsNullOrEmpty(hotel.CoverImageUrl) ? "https://images.unsplash.com/photo-1566073771259-6a8506099945?fit=crop&w=800&q=80" : hotel.CoverImageUrl)"
                                 alt="@hotel.Name"
                                 class="w-100 h-100 object-fit-cover">

                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    @* ✅ GÜNCELLEME: Rating değeri null veya 0 ise 0.0 göster *@
                                    @(string.IsNullOrEmpty(hotel.Rating) || hotel.Rating == "0" ? "0.0" : hotel.Rating)
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1">@hotel.Name</h5>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-danger"></i> @hotel.City, @hotel.Country</p>

                            <p class="card-text text-secondary small flex-grow-1 mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(hotel.Description) ? "Detaylı açıklama için incele butonuna tıklayın." : hotel.Description)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                <div>
                                    <small class="text-muted d-block">Gecelik Başlayan</small>
                                    <span class="fw-bold fs-5 text-primary">@hotel.MinPrice.ToString("C")</span>
                                </div>
                                <a href="/hotel/details/@hotel.Id" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                                    İncele <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="text-center py-5">
                    <div class="display-1 text-muted opacity-25 mb-4"><i class="bi bi-geo-fill"></i></div>
                    <h2 class="fw-bold">Sonuç Bulunamadı</h2>
                    <p class="text-muted fs-5">Aradığınız kriterlere uygun aktif bir otel bulunmuyor.</p>
                    <a href="/hotel" class="btn btn-primary btn-lg rounded-pill mt-3 px-5">Tüm Otellere Göz At</a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hotel-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,.05);
    }

        .hotel-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }

    .input-group-text {
        border-right: none;
    }

    .form-control:focus {
        box-shadow: none;
    }
</style>