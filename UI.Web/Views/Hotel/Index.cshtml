@using Core.Concretes.DTOs
@using System.Globalization
@model List<HotelDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Konaklama Seçenekleri";
}

<div class="container-fluid mt-4">
    @* ... Başlık ve Butonlar Kısmı (Değişmedi) ... *@
    <div class="row mb-4 align-items-end">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold text-dark">🏨 Otelleri Keşfedin</h1>
            <p class="text-muted fs-5">
                @if (!string.IsNullOrEmpty(ViewBag.City) || !string.IsNullOrEmpty(ViewBag.SearchKeyword))
                {
                    <span>
                        🔍 <strong>@(ViewBag.SearchKeyword ?? "Tüm Oteller")</strong>
                        @(!string.IsNullOrEmpty(ViewBag.City) ? " - " + ViewBag.City : "") listeleniyor (@ViewBag.ResultCount sonuç)
                    </span>
                }
            </p>
        </div>
    </div>

    @* --- Gelişmiş Arama Çubuğu (Her İki Kutuda da Geçmişi Tamamen Engelleyen Yapı) --- *@
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                <div class="card-body p-4">
                    <form method="get" action="/hotel" class="row g-3 justify-content-center" autocomplete="off">

                        @* ✅ Otel İsmi Girişi: Geçmişi kapatmak için 'new-password' ile güncellendi *@
                        <div class="col-md-5">
                            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                                <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-search text-primary"></i></span>
                                <input type="text"
                                       name="searchTerm"
                                       id="hotelSearchInput"
                                       class="form-control border-0 py-3 no-history"
                                       placeholder="Otel adı ile ara..."
                                       value="@ViewBag.SearchKeyword"
                                       autocomplete="new-password">
                            </div>
                        </div>

                        @* ✅ Şehir Girişi: Geçmişi kapatmak için 'one-time-code' koruması devam ediyor *@
                        <div class="col-md-5">
                            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                                <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-geo-alt text-primary"></i></span>
                                <input type="text"
                                       name="city"
                                       id="citySearchInput"
                                       class="form-control border-0 py-3 no-history"
                                       placeholder="Şehir giriniz..."
                                       value="@ViewBag.City"
                                       autocomplete="one-time-code">
                                <button type="submit" class="btn btn-primary px-5 fw-bold">🔍 Ara</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* ... Otel Kartları ve Geri Kalan Kısımlar (Değişmedi) ... *@
    @if (Model != null && Model.Any(h => h.IsActive))
    {
        <div class="row">
            @foreach (var hotel in Model.Where(h => h.IsActive))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm hotel-card rounded-4 overflow-hidden">
                        <div class="position-relative" style="height: 230px;">
                            @{
                                string coverUrl = "https://images.unsplash.com/photo-1566073771259-6a8506099945?fit=crop&w=800&q=80";
                                if (!string.IsNullOrEmpty(hotel.CoverImageUrl))
                                {
                                    coverUrl = hotel.CoverImageUrl.Replace("\\", "/");
                                }
                            }
                            <img src="@coverUrl" class="w-100 h-100 object-fit-cover">
                        </div>
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold">@hotel.Name</h5>
                            <p class="text-muted small">@hotel.City, @hotel.Country</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fw-bold text-primary">@hotel.MinPrice.ToString("N0") ₺</span>
                                <a href="/hotel/details/@hotel.Id" class="btn btn-primary btn-sm rounded-pill">İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.no-history');

            inputs.forEach(input => {
                // Her iki kutu için de odaklanıldığında (focus) tarayıcıyı yanıltmaya devam et
                input.addEventListener('focus', function() {
                    // Şehir kutusu için farklı, Otel kutusu için farklı yanıltıcı kullanarak tarayıcıyı bozuyoruz
                    if(this.id === 'hotelSearchInput') {
                        this.setAttribute('autocomplete', 'new-password');
                    } else {
                        this.setAttribute('autocomplete', 'one-time-code');
                    }
                });

                // URL parametresi yoksa (temiz sayfa) kutuları boşalt
                const urlParams = new URLSearchParams(window.location.search);
                if (!urlParams.has('city') && !urlParams.has('searchTerm')) {
                    input.value = '';
                }
            });
        });
    </script>
}

<style>
    .hotel-card:hover {
        transform: translateY(-8px);
        transition: all 0.3s ease;
    }

    .form-control:focus {
        box-shadow: none;
    }
</style>