@using Core.Concretes.DTOs
@model IEnumerable<RoomDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Oda Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-door-open me-2"></i>@ViewBag.HotelName - Odalar</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/hotel">Dashboard</a></li>
                    <li class="breadcrumb-item active">Odalar</li>
                </ol>
            </nav>
        </div>
        <a href="/admin/room/create/@ViewBag.HotelId" class="btn btn-primary rounded-pill px-4 shadow">
            <i class="bi bi-plus-lg me-1"></i> Yeni Oda Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning rounded-4 border-0 shadow-sm p-4 text-center">
            <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
            Henüz bu otele ait bir oda kaydı bulunamadı. Hemen bir tane ekleyerek başlayın!
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Oda Adı</th>
                                <th>Kapasite</th>
                                <th>Boyut (m²)</th>
                                <th>Gecelik Fiyat</th>
                                <th>Durum</th>
                                <th class="text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@room.Name</td>
                                    <td><i class="bi bi-people me-1"></i> @room.Capacity Kişilik</td>
                                    <td>@room.Size m²</td>
                                    <td class="fw-bold text-success">@room.Price.ToString("C2")</td>
                                    <td>
                                        @if (room.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Pasif</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a href="/admin/room/edit/@room.Id" class="btn btn-sm btn-outline-warning rounded-pill me-2">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@room.Id" asp-route-hotelId="@ViewBag.HotelId" method="post" onsubmit="return confirm('Bu odayı silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>