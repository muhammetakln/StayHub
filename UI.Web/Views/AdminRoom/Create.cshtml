@using Core.Concretes.DTOs
@using Core.Concretes.Enum
@model CreateRoomDto

@{
    ViewData["Title"] = ViewBag.Title ?? "Oda İşlemleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-info text-white p-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-door-open-fill me-2"></i>@ViewBag.Title
                    </h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger shadow-sm">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="roomCreateForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="HotelId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="RoomNumber"></label>
                                <input type="text" class="form-control" asp-for="RoomNumber" placeholder="Örn: 101-A">
                                <span asp-validation-for="RoomNumber" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Name"></label>
                                <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Deluxe Suit">
                                <span asp-validation-for="Name" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Price"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" step="0.01" class="form-control" asp-for="Price">
                                </div>
                                <span asp-validation-for="Price" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Capacity"></label>
                                <input type="number" class="form-control" asp-for="Capacity">
                                <span asp-validation-for="Capacity" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Size"></label>
                                <div class="input-group">
                                    <input type="number" class="form-control" asp-for="Size">
                                    <span class="input-group-text">m²</span>
                                </div>
                                <span asp-validation-for="Size" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="FloorNumber"></label>
                                <input type="number" class="form-control" asp-for="FloorNumber">
                                <span asp-validation-for="FloorNumber" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Type"></label>
                                <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<RoomType>()"></select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Status"></label>
                                <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold" asp-for="Description"></label>
                            <textarea class="form-control" asp-for="Description" rows="3" placeholder="Oda hakkında kısa bilgi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        @* ✅ GELİŞMİŞ ÇOKLU FOTOĞRAF YÜKLEME ALANI *@
                        <div class="mb-4 p-4 bg-light rounded-4 border shadow-sm">
                            <label class="form-label fw-bold d-block mb-3">
                                <i class="bi bi-images me-2 text-info"></i>Oda Fotoğrafları Yönetimi
                            </label>

                            <div class="upload-area border-2 border-dashed rounded-3 p-4 text-center mb-3 bg-white"
                                 style="cursor:pointer;" onclick="document.getElementById('imageInput').click()">
                                <i class="bi bi-cloud-arrow-up fs-1 text-info"></i>
                                <p class="mt-2 mb-0 fw-bold">Dosyaları seçmek için tıklayın</p>
                                <span class="text-muted small">Birden fazla görsel seçebilirsiniz</span>
                            </div>

                            <input type="file" name="Images" id="imageInput" class="d-none" accept=".jpg,.jpeg,.png,.webp" multiple>

                            <div id="imagePreviewContainer" class="row g-3">
                                @* Önizlemeler dinamik olarak buraya gelecek *@
                            </div>
                        </div>

                        <div class="mb-4 form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" checked>
                            <label class="form-check-label fw-bold" for="activeSwitch">Oda Satışa Açık (Aktif)</label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-3 border-top">
                            <a href="/admin/room/index/@Model.HotelId" class="btn btn-light px-4 rounded-pill border">İptal</a>
                            <button type="submit" class="btn btn-info text-white px-5 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-save me-2"></i>@(Model.Id > 0 ? "Değişiklikleri Kaydet" : "Odayı Sisteme Ekle")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Dosyaları saklamak için DataTransfer objesi kullanıyoruz
        // Böylece tek tek silme işlemi yapabiliriz
        let selectedFiles = new DataTransfer();
        const imageInput = document.getElementById('imageInput');
        const previewContainer = document.getElementById('imagePreviewContainer');

        imageInput.addEventListener('change', function (e) {
            const files = e.target.files;

            for (let i = 0; i < files.length; i++) {
                // Listeye yeni dosyaları ekle
                selectedFiles.items.add(files[i]);
            }

            // Inputu güncelle
            imageInput.files = selectedFiles.files;
            renderPreviews();
        });

        function renderPreviews() {
            previewContainer.innerHTML = '';
            const files = selectedFiles.files;

            Array.from(files).forEach((file, index) => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const col = document.createElement('div');
                        col.className = 'col-6 col-md-3';
                        col.innerHTML = `
                            <div class="position-relative border rounded-3 overflow-hidden shadow-sm bg-white" style="height: 120px;">
                                <img src="${event.target.result}" class="w-100 h-100" style="object-fit: cover;">
                                <button type="button"
                                        class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle"
                                        style="padding: 2px 6px; font-size: 12px; line-height: 1.5;"
                                        onclick="removeImage(${index})">
                                    <i class="bi bi-trash"></i>
                                </button>
                                <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-50 text-white text-truncate p-1 small" style="font-size: 10px;">
                                    ${file.name}
                                </div>
                            </div>
                        `;
                        previewContainer.appendChild(col);
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        window.removeImage = function(index) {
            const newDt = new DataTransfer();
            const files = selectedFiles.files;

            for (let i = 0; i < files.length; i++) {
                if (i !== index) {
                    newDt.items.add(files[i]);
                }
            }

            selectedFiles = newDt;
            imageInput.files = selectedFiles.files;
            renderPreviews();
        };

        // Form gönderilmeden önce son kontrol
        document.getElementById('roomCreateForm').addEventListener('submit', function (e) {
            if (selectedFiles.files.length === 0) {
                if(!confirm("Hiç fotoğraf seçmediniz. Devam etmek istiyor musunuz?")) {
                    e.preventDefault();
                }
            }
        });
    </script>
}

<style>
    .border-dashed {
        border-style: dashed !important;
    }

    .upload-area:hover {
        background-color: #f8f9fa !important;
        border-color: #0dcaf0 !important;
    }
</style>