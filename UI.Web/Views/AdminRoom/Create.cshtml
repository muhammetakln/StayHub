@using Core.Concretes.DTOs
@using Core.Concretes.Enum
@model CreateRoomDto

@{
    ViewData["Title"] = ViewBag.Title ?? "Oda İşlemleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-info text-white p-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-door-open-fill me-2"></i>@ViewBag.Title
                    </h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger shadow-sm">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        @* DTO içindeki özellikleri doğrudan gizli alan olarak taşıyoruz *@
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="HotelId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="RoomNumber"></label>
                                <input type="text" class="form-control" asp-for="RoomNumber" placeholder="Örn: 101-A">
                                <span asp-validation-for="RoomNumber" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Name"></label>
                                <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Deluxe Suit">
                                <span asp-validation-for="Name" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Price"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" step="0.01" class="form-control" asp-for="Price">
                                </div>
                                <span asp-validation-for="Price" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Capacity"></label>
                                <input type="number" class="form-control" asp-for="Capacity">
                                <span asp-validation-for="Capacity" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Size"></label>
                                <div class="input-group">
                                    <input type="number" class="form-control" asp-for="Size">
                                    <span class="input-group-text">m²</span>
                                </div>
                                <span asp-validation-for="Size" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="FloorNumber"></label>
                                <input type="number" class="form-control" asp-for="FloorNumber">
                                <span asp-validation-for="FloorNumber" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Type"></label>
                                <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<RoomType>()"></select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold" asp-for="Status"></label>
                                <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold" asp-for="Description"></label>
                            <textarea class="form-control" asp-for="Description" rows="3" placeholder="Oda hakkında kısa bilgi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch">
                            <label class="form-check-label fw-bold" for="activeSwitch">Oda Satışa Açık (Aktif)</label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-3 border-top">
                            <a href="/admin/room/index/@Model.HotelId" class="btn btn-light px-4 rounded-pill border">İptal</a>
                            <button type="submit" class="btn btn-info text-white px-5 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-save me-2"></i>@(Model.Id > 0 ? "Değişiklikleri Kaydet" : "Odayı Sisteme Ekle")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}