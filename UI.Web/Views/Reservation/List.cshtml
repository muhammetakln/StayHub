@using Core.Concretes.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Rezervasyonlarım";
}

@model List<ReservationDto>

<div class="container-fluid mt-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold">📋 Rezervasyonlarım</h1>
                    <p class="text-muted">Toplam @Model.Count rezervasyon</p>
                </div>
                <div>
                    <a href="/hotel" class="btn btn-outline-primary btn-sm">
                        🏨 Otelleri Gözat
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Reservations List -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var reservation in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm reservation-card">
                        <!-- Card Header with Status -->
                        <div class="card-header @GetStatusColor(reservation.Status)">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@reservation.HotelName</h5>
                                <span class="badge bg-light text-dark">
                                    @GetStatusBadge(reservation.Status)
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body">
                            <!-- Room Info -->
                            <p class="mb-2">
                                <small class="text-muted">🚪 Oda:</small>
                                <br>
                                <strong>@reservation.RoomNumber</strong>
                            </p>

                            <!-- Dates -->
                            <p class="mb-2">
                                <small class="text-muted">📅 Tarihler:</small>
                                <br>
                                <small>
                                    @reservation.CheckInDate.ToString("dd MMM yyyy") →
                                    @reservation.CheckOutDate.ToString("dd MMM yyyy")
                                </small>
                            </p>

                            <!-- Price -->
                            <p class="mb-3 pb-3 border-bottom">
                                <small class="text-muted">💰 Toplam Tutar:</small>
                                <br>
                                <strong class="text-primary fs-5">@reservation.TotalPrice.ToString("C")</strong>
                            </p>

                            <!-- Action Buttons -->
                            <div class="d-grid gap-2">
                                <!-- Details Button -->
                                <a href="/reservation/details/@reservation.Id" class="btn btn-sm btn-outline-primary">
                                    👁️ Detaylar
                                </a>

                                <!-- Payment Button (Only for Pending Status) -->
                                @if (reservation.Status.ToLower() == "pending")
                                {
                                    <a href="/payment/process/@reservation.Id" class="btn btn-sm btn-success">
                                        💳 Ödeme Yap
                                    </a>
                                }
                                else if (reservation.Status.ToLower() == "confirmed")
                                {
                                    <button type="button" class="btn btn-sm btn-success" disabled>
                                        ✅ Ödeme Tamamlandı
                                    </button>
                                }

                                <!-- Cancel Button -->
                                <!-- ✅ DÜZELTME: Sadece iptal edilmemiş VEYA tarihi bugün ve sonrası olanlar iptal edilebilir -->
                                @if (reservation.Status.ToLower() != "cancelled" && reservation.CheckInDate.Date >= DateTime.UtcNow.Date)
                                {
                                    <form method="post" action="/reservation/cancel/@reservation.Id" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger w-100"
                                                onclick="return confirm('Rezervasyonunuzu iptal etmek istediğinize emin misiniz?')">
                                            ❌ İptal Et
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center py-5" role="alert">
                    <h4 class="alert-heading">😢 Rezervasyon Yok</h4>
                    <p>Henüz hiç rezervasyon yapmadınız. Otelleri keşfetmeye başlayın!</p>
                    <hr>
                    <a href="/hotel" class="btn btn-primary btn-sm">
                        🏨 Otelleri Gözat
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    h1 {
        color: #2c3e50;
    }

    .reservation-card {
        transition: transform 0.3s, box-shadow 0.3s;
        border-radius: 12px;
    }

        .reservation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
        }

    .btn-success {
        background: linear-gradient(135deg, #198754, #157347);
        border: none;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #157347, #0d3622);
        }

    .card {
        border-radius: 12px;
    }
</style>

@functions {
    string GetStatusColor(string status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-secondary text-white";

        return status.ToLower() switch
        {
            "confirmed" => "bg-success text-white",
            "pending" => "bg-warning text-dark",
            "cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusBadge(string status)
    {
        if (string.IsNullOrEmpty(status)) return "Bilinmiyor";

        return status.ToLower() switch
        {
            "confirmed" => "✅ Onaylandı",
            "pending" => "⏳ Bekleme",
            "cancelled" => "❌ İptal Edildi",
            _ => status
        };
    }
}