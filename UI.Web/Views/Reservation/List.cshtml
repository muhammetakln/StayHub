@using Core.Concretes.DTOs
@model List<ReservationDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Rezervasyonlarım";
}

<div class="container mt-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold">📋 Rezervasyonlarım</h1>
                    <p class="text-muted">
                        Toplam <strong>@Model.Count</strong> rezervasyon
                    </p>
                </div>
                <div>
                    <a href="/hotel" class="btn btn-outline-primary">
                        🏨 Otel Ara
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Reservations List -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var reservation in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <!-- Card Header -->
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">🏨 @reservation.HotelName</h5>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body">
                            <!-- Room Info -->
                            <div class="mb-3">
                                <p class="mb-1">
                                    <strong>🚪 Oda:</strong> @reservation.RoomNumber
                                </p>
                            </div>

                            <!-- Dates -->
                            <div class="mb-3">
                                <p class="mb-1">
                                    <strong>📅 Giriş:</strong> @reservation.CheckInDate.ToString("dd.MM.yyyy")
                                </p>
                                <p class="mb-0">
                                    <strong>📅 Çıkış:</strong> @reservation.CheckOutDate.ToString("dd.MM.yyyy")
                                </p>
                            </div>

                            <!-- Status Badge -->
                            <div class="mb-3">
                                @if (reservation.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">✅ Onaylandı</span>
                                }
                                else if (reservation.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">⏳ Beklemede</span>
                                }
                                else if (reservation.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">❌ İptal Edildi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">ℹ️ @reservation.Status</span>
                                }
                            </div>

                            <!-- Price -->
                            <div class="mb-3 pb-3 border-bottom">
                                <p class="mb-0">
                                    <strong>💰 Toplam Fiyat:</strong>
                                    <span class="text-primary fw-bold">@reservation.TotalPrice.ToString("C")</span>
                                </p>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2">
                                <!-- Details Button -->
                                <a href="/reservation/details/@reservation.Id" class="btn btn-info btn-sm flex-grow-1">
                                    👁️ Detaylar
                                </a>

                                <!-- Cancel Button (if not cancelled) -->
                                @if (reservation.Status != "Cancelled")
                                {
                                    <form method="post" action="/reservation/cancel/@reservation.Id" style="flex: 1;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm w-100" onclick="return confirm('Rezervasyonu iptal etmek istediğinize emin misiniz?')">
                                            ❌ İptal Et
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center py-5" role="alert">
                    <h4 class="alert-heading">😢 Henüz Rezervasyonunuz Yok</h4>
                    <p>Otelleri keşfetmeye başlamak için başlayın!</p>
                    <hr>
                    <a href="/hotel" class="btn btn-primary btn-lg">
                        🏨 Otelleri Göster
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Info Section -->
    <div class="row mt-5 pt-5 border-top">
        <div class="col-md-3 text-center mb-4">
            <div class="display-6">🔒</div>
            <h6>Güvenli Rezervasyon</h6>
            <p class="text-muted small">SSL şifreli ödeme</p>
        </div>
        <div class="col-md-3 text-center mb-4">
            <div class="display-6">⭐</div>
            <h6>Doğrulanmış Oteller</h6>
            <p class="text-muted small">Gerçek müşteri yorumları</p>
        </div>
        <div class="col-md-3 text-center mb-4">
            <div class="display-6">💰</div>
            <h6>En İyi Fiyat Garantisi</h6>
            <p class="text-muted small">Benzersiz oranlar</p>
        </div>
        <div class="col-md-3 text-center mb-4">
            <div class="display-6">🎧</div>
            <h6>24/7 Destek</h6>
            <p class="text-muted small">Her zaman yardımcı</p>
        </div>
    </div>
</div>

<style>
    h1 {
        color: #2c3e50;
    }

    .card {
        transition: transform 0.3s, box-shadow 0.3s;
        border-radius: 12px;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0a58ca, #084298);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }

    .card-header {
        border-bottom: 2px solid rgba(255, 255, 255, 0.2);
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
    }
</style>
