@using Core.Concretes.Entities
@model List<Reservation>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string activeFilter = ViewBag.ActiveFilter ?? "checkins";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">📊 Günlük Operasyon Raporu</h2>
            <p class="text-muted">@ViewBag.HotelName - @DateTime.Now.ToString("dd MMMM yyyy")</p>
        </div>
        <a href="/admin/hotel" class="btn btn-light rounded-pill border shadow-sm">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard'a Dön
        </a>
    </div>

    @* Filtre Sekmeleri *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group w-100 shadow-sm rounded-4 overflow-hidden p-1 bg-white">
                <a href="?filter=checkins&hotelId=@ViewBag.HotelId"
                   class="btn @(activeFilter == "checkins" ? "btn-primary" : "btn-light") border-0 py-3 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Bugün Gelenler
                </a>
                <a href="?filter=active&hotelId=@ViewBag.HotelId"
                   class="btn @(activeFilter == "active" ? "btn-success" : "btn-light") border-0 py-3 fw-bold">
                    <i class="bi bi-person-check me-2"></i>Şu An Otelde
                </a>
                <a href="?filter=checkouts&hotelId=@ViewBag.HotelId"
                   class="btn @(activeFilter == "checkouts" ? "btn-danger" : "btn-light") border-0 py-3 fw-bold">
                    <i class="bi bi-box-arrow-left me-2"></i>Bugün Gidecekler
                </a>
            </div>
        </div>
    </div>

    @* Liste Tablosu *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Misafir / Oda</th>
                            <th>Tarih Aralığı</th>
                            <th>Kişi</th>
                            <th>Durum</th>
                            <th>Ödeme</th>
                            <th class="text-end pe-4">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var res in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@res.Guest?.FirstName @res.Guest?.LastName</div>
                                        <span class="badge bg-info-subtle text-info small">@res.Room?.Name (@res.Room?.RoomNumber)</span>
                                    </td>
                                    <td>
                                        <div class="small fw-bold">@res.CheckInDate.ToString("dd MMM") - @res.CheckOutDate.ToString("dd MMM")</div>
                                        <small class="text-muted">@( (res.CheckOutDate - res.CheckInDate).Days ) Gece</small>
                                    </td>
                                    <td><i class="bi bi-people me-1"></i> @res.NumberOf Misafir</td>
                                    <td>
                                        @switch (res.Status)
                                        {
                                            case Core.Concretes.Enum.ReservationStatus.Confirmed:
                                                <span class="badge bg-primary-subtle text-primary">Onaylı</span>
                                                break;
                                            case Core.Concretes.Enum.ReservationStatus.CheckedIn:
                                                <span class="badge bg-success">Giriş Yapıldı</span>
                                                break;
                                            case Core.Concretes.Enum.ReservationStatus.CheckedOut:
                                                <span class="badge bg-info">Çıkış Yapıldı</span>
                                                break;
                                            case Core.Concretes.Enum.ReservationStatus.NoShow:
                                                <span class="badge bg-warning text-dark">Gelmedi</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@res.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="fw-bold text-dark">@res.TotalPrice.ToString("C0")</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @* 1. Giriş Yap Butonu *@
                                            @if (res.Status == Core.Concretes.Enum.ReservationStatus.Confirmed)
                                            {
                                                <form method="post" action="/admin/reservation/update-status" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@res.Id" />
                                                    <input type="hidden" name="status" value="CheckedIn" />
                                                    <button type="submit" class="btn btn-sm btn-success px-2" title="Giriş Yap">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* 2. Çıkış Yap Butonu *@
                                            @if (res.Status == Core.Concretes.Enum.ReservationStatus.CheckedIn)
                                            {
                                                <form method="post" action="/admin/reservation/update-status" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@res.Id" />
                                                    <input type="hidden" name="status" value="CheckedOut" />
                                                    <button type="submit" class="btn btn-sm btn-info text-white px-2" title="Çıkış Yap">
                                                        <i class="bi bi-box-arrow-left"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* 3. Gelmedi (No-Show) Butonu *@
                                            @if (res.Status == Core.Concretes.Enum.ReservationStatus.Confirmed && res.CheckInDate.Date <= DateTime.Today)
                                            {
                                                <form method="post" action="/admin/reservation/update-status" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@res.Id" />
                                                    <input type="hidden" name="status" value="NoShow" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning px-2" title="Gelmedi">
                                                        <i class="bi bi-person-x"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* 4. Detay Butonu *@
                                            <a href="/admin/reservation/details/@res.Id" class="btn btn-sm btn-light border px-2" title="Detay">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted italic">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                    Bu kategori için kayıt bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>