@model Core.Concretes.Entities.Reservation
@using System.Globalization
@using Core.Concretes.Enum

@{
    ViewData["Title"] = "Rezervasyon Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm">
                <div>
                    <h2 class="fw-bold mb-0 text-dark">Rezervasyon #@Model.ReservationNumber</h2>
                    <small class="text-muted">Kayıt: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div>
                    <a href="/admin/reservation?hotelId=@Model.Room?.HotelId" class="btn btn-outline-secondary rounded-pill me-2">
                        <i class="bi bi-arrow-left"></i> Listeye Dön
                    </a>
                    <button onclick="window.print()" class="btn btn-dark rounded-pill">
                        <i class="bi bi-printer"></i> Yazdır
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-person-bounding-box me-2"></i>Misafir Bilgileri</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small d-block text-uppercase fw-bold">Ad Soyad</label>
                            <span class="fs-5 fw-bold">@Model.Guest?.FirstName @Model.Guest?.LastName</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small d-block text-uppercase fw-bold">E-Posta / Telefon</label>
                            <span>@Model.Guest?.Email <br /> @Model.Guest?.PhoneNumber</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block text-uppercase fw-bold">Kimlik / Pasaport No</label>
                            <span class="badge bg-light text-dark border">@(Model.Guest?.IdentificationNumber ?? "Belirtilmemiş")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-houses me-2"></i>Konaklama Detayları</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center border-end">
                            <h6 class="text-muted small text-uppercase fw-bold">Seçili Oda</h6>
                            <p class="fw-bold fs-4 text-dark mb-1">@Model.Room?.Name</p>
                            <span class="badge bg-info text-dark">Oda No: @(Model.Room?.RoomNumber ?? "-")</span>
                        </div>
                        <div class="col-md-8 ps-md-4">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="text-muted small d-block fw-bold text-uppercase">Giriş Tarihi</label>
                                    <span class="fw-bold"><i class="bi bi-calendar-plus text-success me-1"></i>@Model.CheckInDate.ToString("dd MMMM yyyy")</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="text-muted small d-block fw-bold text-uppercase">Çıkış Tarihi</label>
                                    <span class="fw-bold"><i class="bi bi-calendar-minus text-danger me-1"></i>@Model.CheckOutDate.ToString("dd MMMM yyyy")</span>
                                </div>
                                <div class="col-6">
                                    <label class="text-muted small d-block fw-bold text-uppercase">Süre</label>
                                    <span class="fw-bold text-primary">@Model.NumberOfNights Gece</span>
                                </div>
                                <div class="col-6">
                                    <label class="text-muted small d-block fw-bold text-uppercase">Misafir Sayısı</label>
                                    <span class="fw-bold text-primary">@Model.NumberOf Kişi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 bg-primary text-white mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-center border-bottom border-white border-opacity-25 pb-3">💰 Ödeme Özeti</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Gecelik (@Model.NumberOfNights Gece)</span>
                        <span>@Model.PricePerNights.ToString("N2") ₺</span>
                    </div>
                    @if (Model.SelectedServices != null && Model.SelectedServices.Any())
                    {
                        <div class="mt-3 pt-3 border-top border-white border-opacity-25">
                            @foreach (var item in Model.SelectedServices)
                            {
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>• @item.AddOnService?.Name</span>
                                    <span>@item.Price.ToString("N2") ₺</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-4 pt-4 border-top border-white border-opacity-50">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-5">Toplam:</span>
                            <span class="fs-2 fw-bold">@Model.TotalPrice.ToString("N2") ₺</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <label class="fw-bold mb-3 d-block"><i class="bi bi-gear-fill me-1"></i>Rezervasyon Durumu</label>
                    <form action="/admin/reservation/update-status" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="status" class="form-select mb-3 shadow-sm border-2">
                            <option value="Pending" selected="@(Model.Status == ReservationStatus.Pending)">⏳ Beklemede</option>
                            <option value="Confirmed" selected="@(Model.Status == ReservationStatus.Confirmed)">✅ Onaylandı</option>
                            <option value="CheckedIn" selected="@(Model.Status == ReservationStatus.CheckedIn)">🔑 Giriş Yapıldı</option>
                            <option value="CheckedOut" selected="@(Model.Status == ReservationStatus.CheckedOut)">🛎️ Çıkış Yapıldı</option>
                            <option value="Cancelled" selected="@(Model.Status == ReservationStatus.Cancelled)">❌ İptal Edildi</option>
                            <option value="NoShow" selected="@(Model.Status == ReservationStatus.NoShow)">🚫 Gelmedi (No-Show)</option>
                        </select>
                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2 shadow-sm">
                            Durumu Güncelle
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.Status == ReservationStatus.Cancelled)
            {
                <div class="alert alert-danger mt-4 rounded-4 border-0 shadow-sm text-center">
                    <strong>Bu rezervasyon iptal edilmiştir.</strong>
                </div>
            }
        </div>
    </div>
</div>