@using Core.Concretes.DTOs
@model IEnumerable<ReservationDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Rezervasyon Yönetimi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-calendar-check me-2 text-primary"></i>Rezervasyonlar</h2>
            <p class="text-muted small mb-0">@ViewBag.HotelName - Tüm konaklama kayıtları.</p>
        </div>
        <a href="/admin/hotel/dashboard/@ViewBag.HotelId" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard'a Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="reservationsTable" class="table table-hover align-middle mb-0 w-100">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-3 py-3">Rezervasyon No</th>
                            <th>Oda Bilgisi</th>
                            <th>Tarih Aralığı</th>
                            <th>Toplam Tutar</th>
                            <th>Durum</th>
                            <th class="text-end pe-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var res in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">ID: #@res.Id</div>
                                        <div class="text-muted small">Otel: @res.HotelName</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@res.RoomNumber</div>
                                        <span class="badge bg-info-subtle text-info x-small">
                                            <i class="bi bi-door-closed me-1"></i>@(res.RoomName ?? "Standart Oda")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">
                                            @res.CheckInDate.ToString("dd.MM.yyyy") - @res.CheckOutDate.ToString("dd.MM.yyyy")
                                        </div>
                                        @{
                                            var nights = (res.CheckOutDate - res.CheckInDate).Days;
                                        }
                                        <div class="text-muted x-small">@nights Gece Konaklama</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success">@res.TotalPrice.ToString("C2")</div>
                                    </td>
                                    <td>
                                        @{
                                            var status = res.Status?.ToString();
                                            var statusClass = status == "Confirmed" ? "bg-success" :
                                            status == "Cancelled" ? "bg-danger" :
                                            status == "Completed" ? "bg-primary" : "bg-warning text-dark";
                                        }
                                        <span class="badge rounded-pill @statusClass px-3">
                                            @(status ?? "Pending")
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="dropdown">
                                            <button class="btn btn-light btn-sm rounded-circle shadow-sm" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                                @* ✅ GÜNCELLENEN DETAY LİNKİ *@
                                                <li>
                                                    <a class="dropdown-item py-2" href="/admin/reservation/details/@res.Id">
                                                        <i class="bi bi-eye me-2 text-primary"></i>Detaylar & Fatura
                                                    </a>
                                                </li>

                                                @if (status != "Cancelled")
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-action="Cancel" asp-route-id="@res.Id" asp-route-hotelId="@res.HotelId" method="post"
                                                              onsubmit="return confirm('Bu rezervasyonu iptal etmek istediğinize emin misiniz?');">
                                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                                <i class="bi bi-x-circle me-2"></i>İptal Et
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .x-small {
        font-size: 0.75rem;
    }

    .btn-light {
        background: #f8f9fa;
        border: 1px solid #eee;
    }

    .dropdown-item {
        font-size: 0.9rem;
        transition: all 0.2s;
    }

        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

    /* DataTables Tasarımı */
    div.dataTables_wrapper div.dataTables_filter input {
        border-radius: 20px;
        padding: 0.4rem 1rem;
        border: 1px solid #dee2e6;
    }

    .dt-buttons .btn {
        border-radius: 8px;
        margin-right: 5px;
        font-weight: 500;
    }

    table.dataTable.table-hover > tbody > tr:hover > * {
        box-shadow: inset 0 0 0 9999px rgba(0,0,0,0.02);
    }
</style>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet" />

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#reservationsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                dom: '<"row align-items-center mb-3"<"col-sm-12 col-md-6"B><"col-sm-12 col-md-6"f>>' + 'rt' + '<"row mt-3"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                buttons: [
                    { extend: 'excelHtml5', className: 'btn btn-success btn-sm shadow-sm', text: '<i class="bi bi-file-earmark-excel"></i> Excel' },
                    { extend: 'pdfHtml5', className: 'btn btn-danger btn-sm shadow-sm', text: '<i class="bi bi-file-earmark-pdf"></i> PDF', orientation: 'landscape' },
                    { extend: 'print', className: 'btn btn-secondary btn-sm shadow-sm', text: '<i class="bi bi-printer"></i> Yazdır' }
                ],
                order: [[2, 'desc']],
                pageLength: 10,
                responsive: true
            });
        });
    </script>
}