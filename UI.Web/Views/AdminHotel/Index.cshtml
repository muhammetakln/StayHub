@using Core.Concretes.DTOs
@model HotelDetailDto

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = (Model?.Name ?? "Yönetim") + " - Yönetim Paneli";
}

<div class="container mt-4">
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/admin/hotel" class="text-decoration-none text-muted">Yönetim</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </nav>
            <h1 class="display-5 fw-bold text-dark mb-2">🏢 @(Model?.Name ?? "Otel Adı")</h1>
            <p class="text-muted fs-5">Tesisinizin genel durumunu ve operasyonlarını buradan yönetin.</p>
        </div>
        <div class="col-md-4 text-md-end">
            @if (Model?.IsActive == true)
            {
                <span class="badge bg-success px-4 py-2 fs-6 shadow-sm rounded-pill">
                    <i class="bi bi-check-circle-fill me-2"></i>Sistemde Aktif
                </span>
            }
            else
            {
                <span class="badge bg-danger px-4 py-2 fs-6 shadow-sm rounded-pill">
                    <i class="bi bi-pause-circle-fill me-2"></i>Şu An Yayında Değil
                </span>
            }
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card stat-card bg-white border-0 shadow-sm h-100 p-3 border-start border-4 border-primary">
                <p class="text-muted mb-1 text-uppercase fw-bold small">Bugün Girişler</p>
                <h3 class="fw-bold mb-0">@(Model?.TodayCheckIns ?? 0)</h3>
                <div class="text-primary small mt-2"><i class="bi bi-box-arrow-in-right"></i> Giriş Bekleyen</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white border-0 shadow-sm h-100 p-3 border-start border-4 border-success">
                <p class="text-muted mb-1 text-uppercase fw-bold small">Şu An Otelde</p>
                <h3 class="fw-bold mb-0">@(Model?.ActiveReservations ?? 0)</h3>
                <div class="text-success small mt-2"><i class="bi bi-person-check"></i> Aktif Konaklama</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white border-0 shadow-sm h-100 p-3 border-start border-4 border-warning">
                <p class="text-muted mb-1 text-uppercase fw-bold small">Misafir Puanı</p>
                <h3 class="fw-bold mb-0">@(Model?.AverageRating.ToString("F1") ?? "0.0")</h3>
                <div class="text-warning small mt-2"><i class="bi bi-star-fill"></i> @(Model?.ReviewCount ?? 0) Yorum</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white border-0 shadow-sm h-100 p-3 border-start border-4 border-info">
                <p class="text-muted mb-1 text-uppercase fw-bold small">Aylık Ciro</p>
                <h3 class="fw-bold mb-0">@(Model?.MonthlyEarning.ToString("C0") ?? "₺0")</h3>
                <div class="text-info small mt-2"><i class="bi bi-cash-stack"></i> Tahmini Kazanç</div>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-grid-1x2-fill me-2 text-primary"></i>Yönetim Modülleri</h3>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card module-card text-center shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                        <i class="bi bi-calendar-check fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Rezervasyonlar</h5>
                    <p class="text-muted small mb-4">Gelen talepleri onaylayın, misafir girişlerini takip edin.</p>
                    @* ✅ BURASI BAĞLANDI *@
                    <a href="/admin/reservation?hotelId=@Model?.Id" class="btn btn-outline-primary mt-auto rounded-pill fw-bold">
                        İncele
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card module-card text-center shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-circle bg-success-subtle text-success mx-auto mb-3">
                        <i class="bi bi-door-open fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Odalarım (@(Model?.Rooms?.Count() ?? 0))</h5>
                    <p class="text-muted small mb-4">Oda kapasitelerini, fiyatlarını ve durumlarını güncelleyin.</p>
                    <a href="/admin/room/index/@Model?.Id" class="btn btn-outline-success mt-auto rounded-pill fw-bold">Yönet</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card module-card text-center shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-circle bg-info-subtle text-info mx-auto mb-3">
                        <i class="bi bi-magic fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Ek Hizmetler (@(Model?.AddOnServices?.Count ?? 0))</h5>
                    <p class="text-muted small mb-4">SPA, Transfer, Kahvaltı gibi servisleri yönetin.</p>
                    <a href="/admin/addon/index/@Model?.Id" class="btn btn-outline-info mt-auto rounded-pill fw-bold">Düzenle</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card module-card text-center shadow-sm h-100 border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-circle bg-secondary-subtle text-secondary mx-auto mb-3">
                        <i class="bi bi-gear-wide-connected fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Ayarlar</h5>
                    <p class="text-muted small mb-4">Otel iletişim bilgilerini ve görsellerini güncelleyin.</p>
                    <a href="/admin/hotel/edit/@Model?.Id" class="btn btn-outline-secondary mt-auto rounded-pill fw-bold">Ayarlar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        border-radius: 16px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.05) !important;
        }

    .module-card {
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .module-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>