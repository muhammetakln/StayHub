@using Core.Concretes.DTOs
@model HotelDetailDto

@{
    ViewData["Title"] = "Otel Detayı";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                @* Üst Bölüm: Kapak Görseli ve Başlık *@
                <div class="position-relative" style="height: 250px; background: url('@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-hotel.jpg" : Model.CoverImageUrl)') center/cover no-repeat;">
                    <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                        <div class="d-flex justify-content-between align-items-end text-white">
                            <div>
                                <h1 class="fw-bold mb-0">@Model.Name</h1>
                                <p class="mb-0 opacity-75"><i class="bi bi-geo-alt"></i> @Model.City, @Model.Country</p>
                            </div>
                            <div class="text-end">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">✓ Aktif Yönetim</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">✗ Pasif Mod</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <div class="row g-4">
                        @* Sol Sütun: Temel Bilgiler *@
                        <div class="col-md-7">
                            <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-info-circle"></i> Genel Açıklama</h5>
                            <p class="text-secondary leading-relaxed">
                                @(string.IsNullOrEmpty(Model.Description) ? "Bu otel için henüz bir açıklama girilmemiş." : Model.Description)
                            </p>

                            <h5 class="fw-bold border-bottom pb-2 mb-3 mt-4 text-primary"><i class="bi bi-telephone"></i> İletişim & Adres</h5>
                            <div class="bg-light p-3 rounded-3">
                                <p class="mb-2"><strong>📍 Tam Adres:</strong> @Model.Address</p>
                                <p class="mb-2"><strong>📞 Telefon:</strong> @Model.PhoneNumber</p>
                                <p class="mb-0"><strong>✉️ Email:</strong> @Model.Email</p>
                            </div>
                        </div>

                        @* Sağ Sütun: İstatistikler ve Saatler *@
                        <div class="col-md-5">
                            <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-clock"></i> Operasyonel Bilgiler</h5>
                            <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Puan / Rating</span>
                                    <span class="badge bg-warning text-dark fw-bold">⭐ @Model.Rating / 5</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Otel Türü</span>
                                    <span class="badge bg-info text-dark">@Model.HotelType</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Check-in Saati</span>
                                    <span class="fw-bold text-success">@Model.CheckInTime</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Check-out Saati</span>
                                    <span class="fw-bold text-danger">@Model.CheckOutTime</span>
                                </div>
                            </div>

                            @* Hızlı Erişim Butonları *@
                            <div class="mt-4">
                                <a href="/admin/room?hotelId=@Model.Id" class="btn btn-outline-primary w-100 mb-2 py-2">
                                    <i class="bi bi-door-open"></i> Odaları Yönet
                                </a>
                                <a href="/admin/reservation?hotelId=@Model.Id" class="btn btn-outline-dark w-100 py-2">
                                    <i class="bi bi-calendar-check"></i> Rezervasyonları Gör
                                </a>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5">

                    @* Alt Bölüm: İşlem Butonları *@
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <a href="/admin/hotel" class="btn btn-secondary px-4 py-2 rounded-pill">
                            <i class="bi bi-arrow-left"></i> Listeye Dön
                        </a>
                        <div class="d-flex gap-2">
                            <a href="/admin/hotel/edit/@Model.Id" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark shadow-sm">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                            <a href="/admin/hotel/delete/@Model.Id" class="btn btn-danger px-4 py-2 rounded-pill fw-bold shadow-sm" onclick="return confirm('Bu oteli silmek istediğinize emin misiniz?')">
                                <i class="bi bi-trash"></i> Oteli Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-center mt-4 text-muted small">Kayıt ID: #@Model.Id | Son Güncelleme: @DateTime.Now.ToShortDateString()</p>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 20px !important;
    }

    .rounded-4 {
        border-radius: 20px !important;
    }

    /* Buton Tasarımları */
    .btn-warning {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        border: none;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #ff9800, #fb8c00);
            transform: translateY(-2px);
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #c82333);
        border: none;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c82333, #bd2130);
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: linear-gradient(135deg, #6c757d, #495057);
        border: none;
    }

    .leading-relaxed {
        line-height: 1.6;
    }
</style>