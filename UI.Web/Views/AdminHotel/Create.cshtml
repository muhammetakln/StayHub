@using Core.Concretes.DTOs
@model CreateHotelDto

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Yeni Otel Kaydı";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            @* Adım Göstergesi *@
            <div class="d-flex justify-content-between mb-4 px-5">
                <div class="text-center">
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center shadow" style="width:40px; height:40px;">1</div>
                    <p class="small fw-bold mt-2">Otel Bilgileri</p>
                </div>
                <div class="flex-grow-1 border-bottom mb-4 mx-3 opacity-25" style="margin-top:20px;"></div>
                <div class="text-center opacity-50">
                    <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width:40px; height:40px;">2</div>
                    <p class="small mt-2">Odalar</p>
                </div>
                <div class="flex-grow-1 border-bottom mb-4 mx-3 opacity-25" style="margin-top:20px;"></div>
                <div class="text-center opacity-50">
                    <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width:40px; height:40px;">3</div>
                    <p class="small mt-2">Tamamla</p>
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header border-0 p-4" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3 me-3">
                            <i class="bi bi-building-fill-add text-white fs-2"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold text-white">Yeni Otel Kaydı</h3>
                            <p class="mb-0 text-white-50">Önce temel bilgileri ve ek hizmetleri kaydedelim.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div asp-validation-summary="All" class="alert alert-danger d-none" id="errorSummary"></div>

                    @* ✅ Dosya yükleme için enctype eklendi *@
                    <form asp-controller="AdminHotel" asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2"><i class="bi bi-info-circle me-2"></i>Genel Bilgiler</h5>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Otel Adı *</label>
                            <input type="text" class="form-control form-control-lg" asp-for="Name" placeholder="StayHub Otel">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-bold">Şehir *</label>
                                <input type="text" class="form-control" asp-for="City" placeholder="İstanbul">
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Region" class="form-label fw-bold">Bölge</label>
                                <input type="text" class="form-control" asp-for="Region" placeholder="Karaköy">
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Country" class="form-label fw-bold">Ülke *</label>
                                <input type="text" class="form-control" asp-for="Country" value="Türkiye">
                            </div>
                        </div>

                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2 mt-5"><i class="bi bi-telephone me-2"></i>İletişim & Detaylar</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">E-Posta *</label>
                                <input type="email" class="form-control" asp-for="Email" placeholder="info@otel.com">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">Telefon *</label>
                                <input type="tel" class="form-control" asp-for="PhoneNumber" placeholder="0212...">
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="HotelType" class="form-label fw-bold">Otel Türü</label>
                                <select class="form-select" asp-for="HotelType">
                                    <option value="Boutique">Butik Otel</option>
                                    <option value="Resort">Resort</option>
                                    <option value="Business">Şehir Oteli</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StarRating" class="form-label fw-bold">Yıldız Sayısı</label>
                                <select class="form-select" asp-for="StarRating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <option value="@i">@i Yıldız</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Otel Açıklaması *</label>
                            <textarea class="form-control" asp-for="Description" rows="4" placeholder="Otelinizin sunduğu ayrıcalıkları anlatın..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 bg-light p-3 rounded-3 mb-4 border">
                            <div class="col-md-6">
                                <label asp-for="CoverImageUrl" class="form-label fw-bold">Kapak Resmi URL</label>
                                <input type="url" class="form-control" asp-for="CoverImageUrl" placeholder="https://...">
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CheckInTime" class="form-label fw-bold">Giriş Saati</label>
                                <input type="time" class="form-control" asp-for="CheckInTime" value="14:00">
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CheckOutTime" class="form-label fw-bold">Çıkış Saati</label>
                                <input type="time" class="form-control" asp-for="CheckOutTime" value="12:00">
                            </div>
                        </div>

                        @* ✅ YENİ: FOTOĞRAF YÜKLEME ALANI *@
                        <div class="mb-5 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-bold"><i class="bi bi-images me-2 text-primary"></i>Otel Fotoğrafları Yükle</label>
                            <input type="file" name="HotelImages" id="imageInput" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple>
                            <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3">
                                @* Önizlemeler buraya gelecek *@
                            </div>
                            <div class="form-text small text-muted">Galeriniz için birden fazla fotoğraf seçebilirsiniz.</div>
                        </div>

                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2 mt-5">
                            <i class="bi bi-box-seam me-2"></i>Ek Hizmetler (Opsiyonel)
                        </h5>

                        <div id="addOnServicesContainer" class="mb-3">
                            <div class="row g-2 mb-2 service-row align-items-center">
                                <div class="col-md-4">
                                    <input type="text" name="AddOnServices[0].Name" class="form-control" placeholder="Hizmet Adı" />
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <span class="input-group-text">₺</span>
                                        <input type="number" step="0.01" name="AddOnServices[0].Price" class="form-control" placeholder="Fiyat" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <input type="text" name="AddOnServices[0].Unit" class="form-control" placeholder="Birim" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger w-100" onclick="removeService(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mb-5">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addServiceRow()">
                                <i class="bi bi-plus-circle me-1"></i> Yeni Hizmet Satırı Ekle
                            </button>
                        </div>

                        <div class="alert alert-info border-0 shadow-sm rounded-3 mb-5 d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Bilgi:</strong> Kayıttan sonra <strong>Oda Ekleme</strong> sayfasına geçeceksiniz.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/admin/hotel" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">Vazgeç</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                                Kaydet ve Devam Et <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Görsel Önizleme
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';

            const files = e.target.files;
            for (const file of files) {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const imgWrapper = document.createElement('div');
                        imgWrapper.innerHTML = `
                            <img src="${event.target.result}" class="rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 1px solid #dee2e6;">
                        `;
                        container.appendChild(imgWrapper);
                    };
                    reader.readAsDataURL(file);
                }
            }
        });

        // Hata Özeti Kontrolü
        document.addEventListener('DOMContentLoaded', function () {
            var summary = document.querySelector('#errorSummary ul');
            if (summary && summary.children.length > 0) {
                document.getElementById('errorSummary').classList.remove('d-none');
            }
        });

        // Ek Hizmetler
        let serviceIndex = 1;
        function addServiceRow() {
            const container = document.getElementById('addOnServicesContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 mb-2 service-row align-items-center';
            row.innerHTML = `
                <div class="col-md-4">
                    <input type="text" name="AddOnServices[${serviceIndex}].Name" class="form-control" placeholder="Hizmet Adı" />
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">₺</span>
                        <input type="number" step="0.01" name="AddOnServices[${serviceIndex}].Price" class="form-control" placeholder="Fiyat" />
                    </div>
                </div>
                <div class="col-md-3">
                    <input type="text" name="AddOnServices[${serviceIndex}].Unit" class="form-control" placeholder="Birim" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-danger w-100" onclick="removeService(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
            serviceIndex++;
        }

        function removeService(btn) {
            btn.closest('.service-row').remove();
        }
    </script>
}