@using Core.Concretes.DTOs
@model UpdateHotelDto

@{
    ViewData["Title"] = "Otel Yönetimi & Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Otel Bilgilerini Güncelle</h3>
                        <small class="opacity-75">Genel otel ayarları ve iletişim bilgileri.</small>
                    </div>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold">Otel Adı *</label>
                            <input type="text" class="form-control form-control-lg" asp-for="Name" required>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Şehir *</label>
                                <input type="text" class="form-control" asp-for="City" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Ülke *</label>
                                <input type="text" class="form-control" asp-for="Country" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Açık Adres *</label>
                            <input type="text" class="form-control" asp-for="Address" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Telefon *</label>
                                <input type="tel" class="form-control" asp-for="PhoneNumber" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Email *</label>
                                <input type="email" class="form-control" asp-for="Email" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Giriş Saati (Check-in)</label>
                                <input type="time" class="form-control" asp-for="CheckInTime" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Çıkış Saati (Check-out)</label>
                                <input type="time" class="form-control" asp-for="CheckOutTime" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Kapak Görseli URL</label>
                            <input type="text" class="form-control" asp-for="CoverImageUrl">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea class="form-control" asp-for="Description" rows="4"></textarea>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="hotelActiveSwitch">
                                <label class="form-check-label fw-bold" for="hotelActiveSwitch">Otel Yayında (Aktif)</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5">
                            <a href="/admin/hotel" class="btn btn-light px-4 rounded-pill border">İptal</a>
                            <button type="submit" class="btn btn-warning px-5 fw-bold rounded-pill shadow-sm">
                                Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-door-open text-primary fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Oda Yönetimi</h5>
                    <p class="text-muted small">Otelinizin odalarını ekleyin, fiyatlandırın ve durumlarını güncelleyin.</p>
                    <a href="/admin/room/@ViewContext.RouteData.Values["id"]" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-gear-fill me-2"></i> Odaları Yönet
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-plus-circle text-success fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Ek Hizmetler</h5>
                    <p class="text-muted small">SPA, Kahvaltı, Havaalanı Transferi gibi ekstra servisleri yönetin.</p>
                    <a href="/admin/addon/list/@ViewContext.RouteData.Values["id"]" class="btn btn-outline-success w-100 rounded-pill">
                        <i class="bi bi-plus-lg me-2"></i> Hizmetleri Yönet
                    </a>
                </div>
            </div>

            <div class="alert alert-info border-0 rounded-4 p-4">
                <h6 class="fw-bold"><i class="bi bi-lightbulb me-2"></i>İpucu</h6>
                <p class="small mb-0">Otelin görünür olması için en az bir <strong>aktif oda</strong> eklemiş olmanız önerilir.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.2);
    }

    .card {
        transition: transform 0.3s ease;
    }

    .rounded-4 {
        border-radius: 1.25rem !important;
    }
</style>