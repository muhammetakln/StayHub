@using Core.Concretes.DTOs
@model UpdateHotelDto

@{
    ViewData["Title"] = "Otel Yönetimi & Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Otel Bilgilerini Güncelle</h3>
                        <small class="opacity-75">Genel otel ayarları, iletişim bilgileri ve ek hizmetler.</small>
                    </div>
                </div>
                <div class="card-body p-4 p-lg-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                                <div><strong>Başarılı!</strong> @TempData["SuccessMessage"]</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data" id="hotelEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CoverImageUrl" id="hfCoverImageUrl" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Otel Adı *</label>
                            <input type="text" class="form-control form-control-lg" asp-for="Name" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Yıldız Sayısı *</label>
                            <select class="form-select" asp-for="StarRating" required>
                                <option value="1">1 Yıldız</option>
                                <option value="2">2 Yıldız</option>
                                <option value="3">3 Yıldız</option>
                                <option value="4">4 Yıldız</option>
                                <option value="5">5 Yıldız</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Şehir *</label>
                                <input type="text" class="form-control" asp-for="City" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Ülke *</label>
                                <input type="text" class="form-control" asp-for="Country" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Açık Adres *</label>
                            <input type="text" class="form-control" asp-for="Address" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Telefon *</label>
                                <input type="tel" class="form-control" asp-for="PhoneNumber" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Email *</label>
                                <input type="email" class="form-control" asp-for="Email" required>
                            </div>
                        </div>

                        <div class="mb-4 p-3 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-25">
                            <label class="form-label fw-bold text-primary">Yönetici Şifresi Belirleyin *</label>
                            <input type="password" class="form-control" asp-for="HotelPassword" minlength="6">
                            <div class="form-text">Mevcut şifreyi değiştirmek istemiyorsanız boş bırakın.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Giriş Saati (Check-in)</label>
                                <input type="time" class="form-control" asp-for="CheckInTime" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Çıkış Saati (Check-out)</label>
                                <input type="time" class="form-control" asp-for="CheckOutTime" required>
                            </div>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-bold"><i class="bi bi-images me-2"></i>Otel Fotoğrafları Yükle</label>
                            <input type="file" name="HotelImages" id="imageInput" class="form-control shadow-sm" accept=".jpg,.jpeg,.png,.webp" multiple>

                            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                            {
                                <div class="mt-3 p-2 bg-white rounded border d-inline-block text-center shadow-sm">
                                    <small class="text-muted d-block mb-1">Mevcut Kapak Resmi</small>
                                    <img src="@Model.CoverImageUrl" class="rounded" style="width: 120px; height: 120px; object-fit: cover; border: 2px solid #ffc107;">
                                </div>
                            }
                            <div id="imagePreviewContainer" class="d-flex flex-wrap gap-3 mt-3 px-2 py-1"></div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea class="form-control" asp-for="Description" rows="4"></textarea>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="hotelActiveSwitch">
                                <label class="form-check-label fw-bold" for="hotelActiveSwitch">Otel Yayında (Aktif)</label>
                            </div>
                        </div>

                        @* --- AMENITIES SECTION --- *@
                        <h5 class="text-warning fw-bold mb-4 border-bottom pb-2 mt-5">
                            <i class="bi bi-stars me-2"></i>Otel Olanakları (Ücretsiz)
                        </h5>
                        <div id="amenitiesContainer" class="mb-3">
                            @if (Model.Amenities != null)
                            {
                                for (int i = 0; i < Model.Amenities.Count; i++)
                                {
                                    <div class="row g-2 mb-2 amenity-row align-items-center">
                                        <input type="hidden" class="amenity-id" value="@Model.Amenities[i].Id" />
                                        <div class="col-md-5">
                                            <input type="text" value="@Model.Amenities[i].Name" class="form-control amenity-name" placeholder="Olanak Adı" required />
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" value="@Model.Amenities[i].IconUrl" class="form-control amenity-icon" placeholder="İkon (bi-wifi)" />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="mb-4">
                            <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3" onclick="addAmenityRow()">
                                <i class="bi bi-plus-circle me-1"></i> Yeni Olanak Ekle
                            </button>
                        </div>

                        @* --- ADD-ON SERVICES SECTION --- *@
                        <h5 class="text-primary fw-bold mb-4 border-bottom pb-2 mt-5">
                            <i class="bi bi-box-seam me-2"></i>Ek Hizmetleri Yönet (Ücretli)
                        </h5>
                        <div id="addOnServicesContainer" class="mb-3">
                            @if (Model.AddOnServices != null)
                            {
                                for (int i = 0; i < Model.AddOnServices.Count; i++)
                                {
                                    <div class="row g-2 mb-2 service-row align-items-center">
                                        <input type="hidden" class="service-id" value="@Model.AddOnServices[i].Id" />
                                        <div class="col-md-4">
                                            <input type="text" value="@Model.AddOnServices[i].Name" class="form-control service-name" placeholder="Hizmet Adı" required />
                                        </div>
                                        <div class="col-md-3">
                                            <div class="input-group">
                                                <span class="input-group-text">₺</span>
                                                <input type="text" value="@Model.AddOnServices[i].Price.ToString("F2")" class="form-control text-end service-price price-input" placeholder="0,00" required />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" value="@(string.IsNullOrEmpty(Model.AddOnServices[i].Unit) ? "Adet" : Model.AddOnServices[i].Unit)" class="form-control service-unit" placeholder="Birim" />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="mb-5">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addServiceRow()">
                                <i class="bi bi-plus-circle me-1"></i> Yeni Hizmet Satırı Ekle
                            </button>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5 pt-3 border-top">
                            <a href="/admin/hotel" class="btn btn-light px-4 rounded-pill border">İptal</a>
                            <button type="submit" class="btn btn-warning px-5 fw-bold rounded-pill shadow-sm">Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4 text-center">
                <div class="card-body p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-door-open text-primary fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Oda Yönetimi</h5>
                    <p class="text-muted small">Otelinizin odalarını ekleyin ve fiyatlandırın.</p>
                    <a href="/admin/room/index/@Model.Id" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-gear-fill me-2"></i> Odaları Yönet
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imageInput = document.getElementById('imageInput');
        const previewContainer = document.getElementById('imagePreviewContainer');

        imageInput.addEventListener('change', function () { renderPreviews(); });

        function renderPreviews() {
            previewContainer.innerHTML = '';
            const files = imageInput.files;
            Array.from(files).forEach((file, index) => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const imgWrapper = document.createElement('div');
                        imgWrapper.className = 'position-relative d-inline-block mt-2 text-center p-1 border rounded bg-white shadow-sm';
                        imgWrapper.innerHTML = `
                            <img src="${event.target.result}" class="rounded" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #dee2e6;">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-100 translate-middle rounded-circle shadow"
                                    style="width: 24px; height: 24px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; border: 2px solid white;"
                                    onclick="removeSelectedImage(${index})"><i class="bi bi-x-lg"></i></button>
                            <div class="form-check mt-2 small d-flex justify-content-center align-items-center">
                                <input class="form-check-input me-1 cover-radio" type="radio" name="coverImageIndex" id="cover_${index}" value="${index}" ${index === 0 ? 'checked' : ''} style="margin-top: 0; cursor: pointer;">
                                <label class="form-check-label text-muted fw-bold" for="cover_${index}" style="cursor: pointer; font-size: 11px;">Kapak Yap</label>
                            </div>`;
                        previewContainer.appendChild(imgWrapper);
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        window.removeSelectedImage = function(index) {
            const dt = new DataTransfer();
            const files = imageInput.files;
            for (let i = 0; i < files.length; i++) { if (i !== index) dt.items.add(files[i]); }
            imageInput.files = dt.files;
            renderPreviews();
        }

        function addServiceRow() {
            const container = document.getElementById('addOnServicesContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 mb-2 service-row align-items-center';
            row.innerHTML = `
                <input type="hidden" class="service-id" value="0" />
                <div class="col-md-4"><input type="text" class="form-control service-name" placeholder="Hizmet Adı" required /></div>
                <div class="col-md-3"><div class="input-group"><span class="input-group-text">₺</span><input type="text" class="form-control text-end service-price price-input" placeholder="0,00" required /></div></div>
                <div class="col-md-3"><input type="text" class="form-control service-unit" value="Adet" /></div>
                <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this)"><i class="bi bi-trash"></i></button></div>`;
            container.appendChild(row);
        }

        function addAmenityRow() {
            const container = document.getElementById('amenitiesContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 mb-2 amenity-row align-items-center';
            row.innerHTML = `
                <input type="hidden" class="amenity-id" value="0" />
                <div class="col-md-5"><input type="text" class="form-control amenity-name" placeholder="Olanak Adı" required /></div>
                <div class="col-md-5"><input type="text" class="form-control amenity-icon" placeholder="bi-wifi" /></div>
                <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this)"><i class="bi bi-trash"></i></button></div>`;
            container.appendChild(row);
        }

        function removeRow(btn) { btn.closest('.row').remove(); }

        document.getElementById('hotelEditForm').addEventListener('submit', function (e) {

            // ✅ DÜZELTME 1: Sadece boşlukları ve noktaları (binlik ayraçları) temizle, virgül kalsın!
            document.querySelectorAll('.price-input').forEach(function (input) {
                if (input.value) {
                    // Sadece boşlukları ve binlik ayraç olan noktaları kaldırıyoruz.
                    // Virgülü (,) ellemeyin, C# onu ondalık ayraç olarak okuyacak.
                    let cleanValue = input.value.trim().replace(/\s+/g, '').replace(/\./g, '');
                    input.value = cleanValue;
                }
            });

            // ✅ DÜZELTME 2: Olanakları İndeksle
            let amenityIndex = 0;
            document.querySelectorAll('.amenity-row').forEach((row) => {
                const amenityId = row.querySelector('.amenity-id');
                const amenityName = row.querySelector('.amenity-name');
                const amenityIcon = row.querySelector('.amenity-icon');

                // Sadece dolu satırları gönder
                if (amenityName.value.trim()) {
                    amenityId.name = `Amenities[${amenityIndex}].Id`;
                    amenityName.name = `Amenities[${amenityIndex}].Name`;
                    amenityIcon.name = `Amenities[${amenityIndex}].IconUrl`;
                    amenityIndex++;
                }
            });

            // ✅ DÜZELTME 3: Ek Hizmetleri İndeksle - Boş satırları filtrele
            let serviceIndex = 0;
            document.querySelectorAll('.service-row').forEach((row) => {
                const serviceId = row.querySelector('.service-id');
                const serviceName = row.querySelector('.service-name');
                const servicePrice = row.querySelector('.service-price');
                const serviceUnit = row.querySelector('.service-unit');

                // Sadece dolu satırları gönder (ad veya fiyat varsa)
                if (serviceName.value.trim() || servicePrice.value.trim()) {
                    serviceId.name = `AddOnServices[${serviceIndex}].Id`;
                    serviceName.name = `AddOnServices[${serviceIndex}].Name`;
                    servicePrice.name = `AddOnServices[${serviceIndex}].Price`;
                    serviceUnit.name = `AddOnServices[${serviceIndex}].Unit`;
                    serviceIndex++;
                }
            });
        });
    </script>
}

<style>
            .cover-radio:checked {
                        background-color: #ffc107;
                        border-color: #ffc107;

    }

            .cover-radio:focus {
                        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);

    }
</style>