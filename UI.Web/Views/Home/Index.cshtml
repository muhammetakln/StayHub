@using Core.Concretes.DTOs
@model List<HotelDto>

@{
    ViewData["Title"] = "StayHub - Lüks ve Konforun Buluşma Noktası";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid position-relative py-5 overflow-hidden" style="background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%); margin-top: -16px;">
    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25"></div>

    <div class="container position-relative z-1 text-center py-5">
        <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 shadow-sm animate__animated animate__fadeInDown">YENİ NESİL KONAKLAMA DENEYİMİ</span>
        <h1 class="display-3 fw-bold text-white mb-4 shadow-sm animate__animated animate__fadeInUp">Sizin İçin En İyi <br><span class="text-primary">Destinasyonları</span> Seçtik</h1>
        <p class="lead text-white-50 fs-4 mb-5 mx-auto" style="max-width: 800px;">
            StayHub ile dünyanın en seçkin otellerinde, unutulmaz anılar biriktirmeye hazır olun.
            Konfor, lüks ve huzuru tek bir platformda topladık.
        </p>

        @* ✅ GÜNCELLENEN BUTONLAR: Giriş ve Admin Butonları Ayrıldı *@
        <div class="d-flex flex-wrap justify-content-center gap-3 animate__animated animate__fadeInUp animate__delay-1s">
            @if (!User.Identity.IsAuthenticated)
            {
                @* Müşteri Keşfet Butonu *@
                <a href="/hotel" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-transform hover-scale">
                    <i class="bi bi-search me-2"></i> Otelleri Keşfet
                </a>

                @* Müşteri Giriş Butonu *@
                <a href="/account/login?userType=Guest" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold transition-transform hover-scale">
                    <i class="bi bi-person-fill me-2"></i> Giriş Yap
                </a>

                @* Otel Yönetim Paneli Butonu *@
                <a href="/account/login?userType=Admin" class="btn btn-warning btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-transform hover-scale text-dark">
                    <i class="bi bi-building-gear me-2"></i> Otel Yönetimi
                </a>
            }
            else
            {
                @* Giriş yapmış kullanıcılar için *@
                <a href="/hotel" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg">
                    Hemen Keşfetmeye Başla <i class="bi bi-arrow-right ms-2"></i>
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a href="/admin/hotel" class="btn btn-warning btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg text-dark">
                        <i class="bi bi-speedometer2 me-2"></i> Yönetim Paneline Git
                    </a>
                }
            }
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
                <div class="icon-box bg-primary-subtle text-primary mx-auto mb-3">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h4 class="fw-bold">Güvenli Rezervasyon</h4>
                <p class="text-muted">Tüm ödeme ve kişisel verileriniz en üst düzey güvenlik protokolleri ile korunur.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
                <div class="icon-box bg-success-subtle text-success mx-auto mb-3">
                    <i class="bi bi-gem fs-2"></i>
                </div>
                <h4 class="fw-bold">Seçkin Tesisler</h4>
                <p class="text-muted">Sadece yüksek hizmet kalitesine sahip, doğrulanmış otelleri listeliyoruz.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
                <div class="icon-box bg-info-subtle text-info mx-auto mb-3">
                    <i class="bi bi-headset fs-2"></i>
                </div>
                <h4 class="fw-bold">7/24 Destek</h4>
                <p class="text-muted">Konaklama öncesinde ve sırasında uzman ekibimiz her zaman yanınızda.</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5 my-3">
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-stars text-warning me-2"></i>Günün Öne Çıkanları</h2>
            <p class="text-muted mb-0">Misafirlerimiz tarafından en yüksek puanı alan tesisler.</p>
        </div>
        <a href="/hotel" class="btn btn-link text-decoration-none fw-bold p-0">Tümünü Gör <i class="bi bi-chevron-right"></i></a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any(h => h.IsActive))
        {
            @foreach (var hotel in Model.Where(h => h.IsActive).Take(4))
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm hotel-card rounded-4 overflow-hidden">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(hotel.CoverImageUrl) ? "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80" : hotel.CoverImageUrl)"
                                 class="card-img-top object-fit-cover" alt="@hotel.Name" style="height: 220px;">

                            <div class="position-absolute top-0 end-0 m-3 bg-dark bg-opacity-75 text-white px-2 py-1 rounded-pill small fw-bold shadow-sm">
                                <i class="bi bi-star-fill text-warning me-1"></i> @(string.IsNullOrEmpty(hotel.Rating) ? "N/A" : hotel.Rating)
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1 text-truncate">@hotel.Name</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @hotel.City
                            </p>

                            <p class="card-text text-secondary small text-truncate-2 mb-4">
                                @hotel.Description
                            </p>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-5 text-dark">@hotel.MinPrice.ToString("C")</span>
                                <a href="/hotel/details/@hotel.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="container py-5 my-5 rounded-5 shadow-lg overflow-hidden position-relative" style="background: url('https://images.unsplash.com/photo-1445019980597-93fa8acb246c?auto=format&fit=crop&w=1920&q=80') center/cover;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.6);"></div>
    <div class="position-relative z-1 text-center py-5">
        <h2 class="display-5 fw-bold text-white mb-3">Hayalinizdeki Tatili Daha Fazla Ertelemeyin</h2>
        <p class="text-white-50 fs-5 mb-4 mx-auto" style="max-width: 600px;">Binlerce otel arasından size en uygun olanı bulmak için sadece bir tık uzaktasınız.</p>
        <a href="/hotel" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold animate__animated animate__pulse animate__infinite">
            Şimdi Otelleri İncele <i class="bi bi-compass ms-2"></i>
        </a>
    </div>
</div>

<style>
    .hotel-card {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid #eee;
    }

        .hotel-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
        }

    .icon-box {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
    }

    .transition-up {
        transition: transform 0.3s ease;
    }

        .transition-up:hover {
            transform: translateY(-5px);
        }

    .hover-scale:hover {
        transform: scale(1.05);
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>