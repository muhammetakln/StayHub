@{
    ViewData["Title"] = "StayHub - Hoş Geldiniz";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Microsoft.AspNetCore.Identity
@using Core.Concretes.Entities
@inject SignInManager<Guest> SignInManager
@inject UserManager<Guest> UserManager

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin-top: -16px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 text-center">

                <div class="mb-5 text-white">
                    <h1 class="display-3 fw-bold mb-3">🏨 StayHub</h1>
                    <p class="lead fs-4">En İyi Otel Deneyimi İçin Bize Katılın</p>
                </div>

                <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @* ✅ KULLANICI GİRİŞ YAPMIŞSA *@
                        <div class="text-center">
                            <h4 class="mb-3 text-dark fw-bold">Tekrar Hoş Geldiniz,</h4>
                            <h5 class="text-primary mb-4">@User.Identity?.Name</h5>

                            <div class="d-grid gap-3">
                                @if (User.IsInRole("Admin"))
                                {
                                    @* 🛠 ADMIN YÖNLENDİRMESİ *@
                                    <a href="/admin/dashboard" class="btn btn-warning btn-lg rounded-3 fw-bold shadow-sm">
                                        ⚡ Yönetim Paneline Git
                                    </a>
                                }
                                else
                                {
                                    @* 🏨 MÜŞTERİ YÖNLENDİRMESİ *@
                                    <a href="/hotel" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                                        🔍 Otelleri Keşfet
                                    </a>
                                }

                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 mt-2 border-0">
                                        🚪 Güvenli Çıkış Yap
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* 🔑 KULLANICI GİRİŞ YAPMAMIŞSA *@
                        <h4 class="mb-4 text-dark fw-bold">Hesabınız var mı?</h4>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm mb-2">
                            🔑 Giriş Yap
                        </a>

                        <div class="d-flex align-items-center my-4">
                            <hr class="flex-grow-1">
                            <span class="mx-3 text-muted">veya</span>
                            <hr class="flex-grow-1">
                        </div>

                        <h5 class="mb-3 text-dark fw-bold">Henüz üye değil misiniz?</h5>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg rounded-3 fw-bold shadow-sm">
                            📝 Hemen Kaydol
                        </a>

                        <div class="mt-4 pt-3 border-top">
                            <a href="/hotel" class="text-decoration-none text-muted">
                                Giriş yapmadan otelleri incele →
                            </a>
                        </div>
                    }
                </div>

                <div class="text-center mt-4 text-white">
                    <p class="small">© 2026 StayHub. Tüm Hakları Saklıdır.</p>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* ... Mevcut stilleriniz korundu ... */
    .btn-warning {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        border: none;
        color: #000;
        padding: 1rem;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #ffb300, #fb8c00);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4) !important;
        }
</style>