{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug",
      "System": "Information"
    }
  },
  "DebugSettings": {
    "ShowSqlQueries": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true
  }
}