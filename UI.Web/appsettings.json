{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=StayHub.db;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "http://localhost:3000;http://localhost:5173;http://localhost:5000",
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSSL": true,
    "UserName": "your-email@gmail.com",
    "Password": "your-app-password",
    "DisplayName": "StayHub Hotel",
    "FromEmail": "your-email@gmail.com"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-min-32-characters-required!",
    "Issuer": "StayHub",
    "Audience": "StayHubClients",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "IdentitySettings": {
    "PasswordMinLength": 8,
    "RequireDigit": true,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireNonAlphanumeric": true
  },
  "ApiSettings": {
    "ApiBaseUrl": "https://localhost:5001",
    "ApiVersion": "v1"
  }
}